    requested=$(jq -r '.params.requestedExpiresAt // ""' "$request")
    if [[ -n $requested ]]; then
        expires=$(date -d "$requested" +%s) || ductor_die 'Invalid requested lease expiry.'
        ((expires > $(date +%s))) || ductor_die 'Requested lease expiry is in the past.'
        ((expires >= deadline)) || deadline=$expires
    fi
    expires=$(date -u -d "@$deadline" +%FT%TZ)
    jq --slurpfile a "$work/agent.json" --arg run "$run" --arg expires "$expires" '.runId=$run | .expiresAt=$expires | .parentAgentId=($a[0].reportsTo // null) | .state="provisioning"' "$lease" | ductor_broker_write "$lease" || return
    ductor_vm create "$vm" "$(jq -r .resources.cpu "$profile")" "$(jq -r .resources.memoryMiB "$profile")" "$(jq -r .resources.diskGiB "$profile")" "$(jq -r .image "$profile")" >&2 || return
    node=$(jq -er --arg vm "$vm" '.placements[]|select(.name==$vm)|.node' "$DUCTOR_STATE_DIR/placements.json") || return
    jq --arg node "$node" '.node=$node' "$lease" | ductor_broker_write "$lease" || return
    started=true
    ductor_vm start "$vm" >&2 || return
    location=$(ductor_broker_location "$lease"); remote=$(jq -r .remote <<< "$location"); project=$(jq -r .project <<< "$location")
    attempts=0
    until timeout 10s incus exec "$remote:$vm" --project "$project" -- true </dev/null >/dev/null 2>&1; do
        attempts=$((attempts+1)); ((attempts <= 30)) || ductor_die 'VM agent did not become ready; the placement is retained for retry.'
        sleep 2
    done
    ductor_broker_expiry "$lease" "$profile" "$expires" "$work" || return
    uid=$(jq -r .runtime.uid "$profile"); gid=$(timeout 30s incus exec "$remote:$vm" --project "$project" -- id -g "$uid") || return
    [[ $gid =~ ^[1-9][0-9]*$ ]] || ductor_die 'Guest account must have a non-root primary group.'
    # Workspace ownership is configured only for the approved image path, never
    # for a request-supplied arbitrary host path.
    timeout 30s incus exec "$remote:$vm" --project "$project" -- install -d -o "$uid" -g "$gid" -m 0700 "$(jq -r .runtime.workspace "$profile")" >/dev/null || return
    ductor_codex_prepare "$profile" "$lease" >&2 || return
    ductor_broker_bind "$profile" "$work/agent.json" "$lease" >&2 || return
    jq --argjson uid "$uid" --argjson gid "$gid" '.uid=$uid|.gid=$gid|.state="running"' "$lease" | ductor_broker_write "$lease" || return
    ductor_broker_lease_reply "$lease" "$profile"
)
ductor_broker_existing() {
    local request=$1 lease=$2 operation=$3 location
    jq -e --slurpfile r "$request" '.companyId==$r[0].params.companyId and .environmentId==$r[0].params.environmentId' "$lease" >/dev/null || ductor_die 'Lease belongs to another company or environment.'
    location=$(ductor_broker_location "$lease") || return
    if [[ $operation == execute || $operation == realize ]]; then
        [[ $(jq -r .state "$lease") == running && $(jq -r .state <<< "$location") == Running ]] || ductor_die 'Lease is not running.'
        (( $(date -d "$(jq -r .expiresAt "$lease")" +%s) > $(date +%s) )) || ductor_die 'Lease expired.'
    fi
    printf '%s\n' "$location"
}
ductor_broker_execute() (
    local request=$1 lease=$2 work=$3 location remote project vm uid gid guest id result remaining budget outer
    location=$(ductor_broker_existing "$request" "$lease" execute) || return
    remote=$(jq -r .remote <<< "$location"); project=$(jq -r .project <<< "$location"); vm=$(jq -r .vm <<< "$location")
    uid=$(jq -r .uid "$lease"); gid=$(jq -r .gid "$lease")
    [[ $uid =~ ^[1-9][0-9]*$ && $gid =~ ^[1-9][0-9]*$ ]] || ductor_die 'Invalid guest identity.'
    id=$(cat /proc/sys/kernel/random/uuid); guest=/run/ductor-rpc/$id.json
    remaining=$(( ($(date -d "$(jq -r .expiresAt "$lease")" +%s) - $(date +%s)) * 1000 ))
    ((remaining > 0)) || ductor_die 'Lease expired before command admission.'
    jq --argjson remaining "$remaining" '.params | {command,args:(.args // []),cwd:(.cwd // "/tmp"),env:(.env // {}),stdin:(.stdin // ""),timeoutMs:([(.timeoutMs // 600000),$remaining,86400000]|min)}' "$request" > "$work/execute.json" || return
