#!/usr/bin/env bash
set -euo pipefail
SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
DUCTOR_BUNDLE="$(cd "$(dirname "$SOURCE")/.." && pwd)"
export DUCTOR_BUNDLE
export PYTHONPATH="$DUCTOR_BUNDLE/src${PYTHONPATH:+:$PYTHONPATH}"
if [[ -x "$DUCTOR_BUNDLE/.venv/bin/python" ]]; then
  exec "$DUCTOR_BUNDLE/.venv/bin/python" -m ductor_core.cli "$@"
fi
exec python3 -m ductor_core.cli "$@"
