export function createBrokerTransport(transport, options = {}) {
  const launch = options.spawn ?? spawn;
  const directory = options.directory ?? fileURLToPath(new URL(".", import.meta.url));
  if (!transport || typeof transport.host !== "string" || !/^(?:[a-zA-Z0-9][a-zA-Z0-9.-]*|[a-fA-F0-9:]+)$/.test(transport.host)
      || typeof transport.user !== "string" || !/^[a-z_][a-z0-9_-]*$/.test(transport.user)
      || !Number.isSafeInteger(transport.port) || transport.port < 1 || transport.port > 65535) throw new Error("Invalid broker transport configuration.");
  return async (operation, params) => {
    if (!OPERATIONS.has(operation)) throw new Error("Unsupported broker operation.");
    const request = JSON.stringify({ protocol: 1, operation, params });
    if (Buffer.byteLength(request) > MAX_RPC_BYTES) throw new Error("Ductor broker request exceeds the 64 MiB transfer limit.");
    const requestedTimeout = operation === "execute" ? params.timeoutMs : params.config?.timeoutMs;
    const timeoutMs = Math.min(86400000, Math.max(1000, Number.isFinite(requestedTimeout) ? requestedTimeout : 600000)) + 60000;
    const args = ["-F", "/dev/null", "-T", "-i", "/paperclip/.ssh/id_ed25519",
      "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
      "-o", `UserKnownHostsFile=${directory}known_hosts`, "-o", "GlobalKnownHostsFile=/dev/null",
      "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=2",
      "-o", "LogLevel=ERROR", "-p", String(transport.port), "--", `${transport.user}@${transport.host}`];
    // No remote shell command: the provisioned SSH key's forced-command entry
    // admits only Ductor broker JSON. No VM is given this transport identity.
    return await new Promise((resolve, reject) => {
      const child = launch("ssh", args, { shell: false, stdio: ["pipe", "pipe", "pipe"], env: { PATH: "/usr/local/bin:/usr/bin:/bin" } });
      const chunks = []; let bytes = 0; let settled = false;
      const finish = (error, result) => {
        if (settled) return;
        settled = true; clearTimeout(timer);
        if (error) reject(error); else resolve(result);
      };
      const timer = setTimeout(() => {
        child.kill("SIGKILL");
        finish(new Error("Ductor broker timed out; inspect the lease before retrying a mutation."));
      }, timeoutMs);
      child.stdout.on("data", (chunk) => {
        bytes += chunk.length;
        if (bytes > MAX_RPC_BYTES) {
          child.kill("SIGKILL");
          finish(new Error("Ductor broker response exceeds the 64 MiB transfer limit."));
        } else chunks.push(chunk);
      });
      // Broker diagnostics can contain command output. Drain without reflecting
      // it into plugin health errors or potentially credential-bearing logs.
      child.stderr.on("data", () => {});
      child.on("error", () => finish(new Error("Could not start the Ductor SSH transport.")));
      child.stdin.on("error", () => {});
      child.on("close", (code) => {
        if (code !== 0) return finish(new Error("Ductor broker rejected the request or transport failed; inspect controller logs."));
        try {
          const result = JSON.parse(Buffer.concat(chunks).toString("utf8"));
          if (!result || typeof result !== "object" || Array.isArray(result)) throw new Error();
          if (result.error) return finish(new Error("Ductor broker could not complete the operation; inspect the task and controller logs."));
          finish(null, result);
        } catch { finish(new Error("Ductor broker returned an invalid response.")); }
      });
      child.stdin.end(request + "\n");
    });
  };
}

export function createDriver(callBroker) {
  return {
    async setup(ctx) {
      ctx.events.on("issue.comment.created", async event => {
        try { await handleSpawnEvent(ctx, callBroker, event); }
        catch { ctx.logger.warn("Ductor spawn request could not complete; inspect its source issue and controller logs."); }
      });
    },
    async onHealth() { return { status: "ok", message: "Ductor provider loaded; probe an environment to verify its broker and profile." }; },
    async onEnvironmentValidateConfig({ config }) {
      try { return { ok: true, normalizedConfig: normalizeConfig(config) }; }
      catch (error) { return { ok: false, errors: [error.message] }; }
    },
    async onEnvironmentProbe(params) { return callBroker("probe", { ...params, config: normalizeConfig(params.config) }); },
    async onEnvironmentAcquireLease(params) { return callBroker("acquire", { ...params, config: normalizeConfig(params.config) }); },
    async onEnvironmentResumeLease(params) { return callBroker("resume", { ...params, config: normalizeConfig(params.config) }); },
    async onEnvironmentReleaseLease(params) { return callBroker("release", params); },
    async onEnvironmentStopLease(params) { return callBroker("release", { ...params, resourceDisposition: "stop_and_retain" }); },
    async onEnvironmentDestroyLease(params) { return callBroker("destroy", params); },
    async onEnvironmentRealizeWorkspace(params) { return callBroker("realize", params); },
    async onEnvironmentExecute(params) { return callBroker("execute", params); }
  };
}

