        # Count allocated VMs, including stopped workspaces: no oversubscription
        # through hidden disk retention or repeated deployment requests.
        local -a leases=(); shopt -s nullglob; leases=("$DUCTOR_STATE_DIR"/leases/d-*.json); shopt -u nullglob
        if ((${#leases[@]})); then
            jq -se --slurpfile p "$profile" '[.[]|select(.profile==$p[0].name)] | length < $p[0].maxInstances' "${leases[@]}" >/dev/null || ductor_die 'Agent type allocation limit reached.'
        fi
