    printf 'ductor-broker ALL=(root) NOPASSWD: /usr/local/bin/ductor broker\n' > "$temporary"
    visudo -cf "$temporary" >/dev/null || { rm -f "$temporary"; ductor_die 'Invalid broker sudo policy.'; }
    install -o root -g root -m 0440 "$temporary" /etc/sudoers.d/ductor-broker; rm -f "$temporary"
    cat > /etc/systemd/system/ductor-lease-reaper.service <<'UNIT'
[Unit]
Description=Enforce Ductor lease deadlines
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ductor broker reap
UNIT
    cat > /etc/systemd/system/ductor-lease-reaper.timer <<'UNIT'
[Unit]
Description=Check Ductor lease deadlines
[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
Persistent=true
[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload; systemctl enable --now ductor-lease-reaper.timer
    ductor_log 'Forced-command SSH broker and lease reaper installed. Configure the verified SSH host key with ductor provider prepare.'
}
ductor_broker_reap() {
    local lease expired=false
    local -a leases=(); shopt -s nullglob; leases=("$DUCTOR_STATE_DIR"/leases/d-*.json); shopt -u nullglob
    for lease in "${leases[@]}"; do
        case $(jq -r .state "$lease") in running|provisioning) ;; *) continue ;; esac
