ductor_console_profile_save() (
    umask 077
    local profile=$1 work
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-profile-save.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_profile_validate "$profile" || return 1
    ductor_config_seed >"$work/config" || return 1
    jq --slurpfile profile "$profile" '.profiles=(.profiles | map(select(.name!=$profile[0].name)))+[$profile[0]]' "$work/config" >"$work/new" || return 1
    ductor_config_validate "$work/new" || return 1
    # Profile import enforces immutable policies before updating desired state.
    ductor_console_exec profiles import "$profile" || return 1
    ductor_console_exec config import "$work/new"
)

ductor_console_profile_create() (
    umask 077
    local work name company repository role model connection grant image cpu ram disk uid command workspace scope tools max_instances run_seconds allowed='' total=0 concurrent=0 depth=0 write=false artifact_selected=false artifact_version='' artifact_url='' artifact_sha=''
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-profile-form.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_console_exec profiles example >"$work/profile" || return 1
    if ductor_ui_confirm 'Subscription and model choices' 'Show the current Paperclip subscription connections and exact available model IDs before configuring this agent type?'; then
        ductor_console_run 'Available ChatGPT subscription grants' paperclip connections || true
        ductor_console_run 'Available Codex models' paperclip models || true
    fi
    company=''
    if [[ -f $DUCTOR_STATE_DIR/paperclip/connection.json ]]; then company=$(jq -r '.companyId // ""' "$DUCTOR_STATE_DIR/paperclip/connection.json") || return 1; fi
    name=$(ductor_ui_input 'Agent type' 'Versioned profile name; lowercase letters, digits and hyphens' repository-engineer) || return 0
    company=$(ductor_ui_input 'Agent type' 'Paperclip company UUID' "$company") || return 0
    repository=$(ductor_ui_input 'Agent type' 'Repository HTTPS URL') || return 0
    role=$(ductor_ui_menu 'Agent role' 'Choose the native Paperclip role.' ceo 'Main coordinator' cto 'Technical coordinator' pm 'Project manager' engineer 'Implementation' qa 'Independent review' devops 'Infrastructure' researcher 'Research' general 'Secretary or general assistant' security 'Security review' designer 'Design') || return 0
    connection=$(ductor_ui_input 'Provider account' 'Connected shared ChatGPT subscription connection UUID') || return 0
    grant=$(ductor_ui_input 'Provider account' 'Subscription grant UUID for this company') || return 0
    model=$(ductor_ui_input 'Provider model' 'Exact model ID listed by Paperclip; no automatic fallback') || return 0
    image=$(ductor_ui_input 'Incus environment' 'Existing versioned Incus platform image alias' local:your-versioned-platform-image) || return 0
    cpu=$(ductor_ui_budget 'CPU threads per agent VM' 2 999999) || return 0
    ram=$(ductor_ui_budget 'Memory per agent VM, MiB' 4096 999999) || return 0
    disk=$(ductor_ui_budget 'Disk per agent VM, GiB' 20 999999) || return 0
    max_instances=$(ductor_ui_budget 'Maximum active instances of this agent type' 4 999999) || return 0
    uid=$(ductor_ui_budget 'Nonroot Codex runtime UID inside the image' 1000 65533) || return 0
    command=$(ductor_ui_input 'Incus runtime' 'Absolute Codex executable path inside the image' /usr/local/bin/codex) || return 0
    if ductor_ui_confirm 'Pinned Codex installation' 'Install or verify an approved native Codex release inside each VM? Provide its official OpenAI release URL, stable version and independently verified SHA256. Decline to require Codex already installed in the image.'; then
        artifact_selected=true
        artifact_version=$(ductor_ui_input 'Pinned Codex release' 'Approved stable Codex release version, major.minor.patch') || return 0
        artifact_url=$(ductor_ui_input 'Pinned Codex release' 'Official HTTPS OpenAI Codex Linux musl release archive URL') || return 0
        artifact_sha=$(ductor_ui_input 'Pinned Codex release' 'Independently verified archive SHA256, 64 hexadecimal characters') || return 0
        command=/usr/local/bin/codex
    fi
    workspace=$(ductor_ui_input 'Incus runtime' 'Absolute working directory inside the image' /workspace) || return 0
    run_seconds=$(ductor_ui_budget 'Maximum run duration, seconds (at least 60)' 3600 86400) || return 0
    scope=$(ductor_ui_input 'Memory access' 'Approved dedicated memory scope ID; blank uses the provisioned agent scope') || return 0
    if ductor_ui_confirm 'Memory access' 'Allow this agent type to write into its approved memory scope?'; then write=true; fi
    tools=$(ductor_ui_input 'Tool access' 'Approved ContextForge tool IDs, comma separated; blank adds no extra tools') || return 0
    if ductor_ui_confirm 'Child-agent policy' 'Allow this agent type to request child agents through bounded Ductor provisioning?'; then
        allowed=$(ductor_ui_input 'Child-agent policy' 'Allowed child profile names, comma separated') || return 0
        total=$(ductor_ui_budget 'Maximum total child agents' 4 100) || return 0
        concurrent=$(ductor_ui_budget 'Maximum concurrent child agents' "$total" "$total") || return 0
        depth=$(ductor_ui_budget 'Maximum descendant depth' 1 16) || return 0
        [[ -n $allowed ]] || { ductor_ui_message 'Child policy incomplete' 'At least one allowed child profile is required when child creation is enabled.'; return 1; }
    fi
    jq --arg name "$name" --arg company "$company" --arg repository "$repository" --arg role "$role" --arg model "$model" --arg connection "$connection" --arg grant "$grant" --arg image "$image" --arg command "$command" --arg workspace "$workspace" --arg scope "$scope" --arg tools "$tools" --arg allowed "$allowed" --argjson cpu "$cpu" --argjson ram "$ram" --argjson disk "$disk" --argjson uid "$uid" --argjson max "$max_instances" --argjson duration "$run_seconds" --argjson write "$write" --argjson total "$total" --argjson concurrent "$concurrent" --argjson depth "$depth" '
      .name=$name | .companyId=$company | .repository=$repository | .role=$role | .model=$model |
      .connectionId=$connection | .grantId=$grant | .image=$image |
      .resources={cpu:$cpu,memoryMiB:$ram,diskGiB:$disk} |
      .runtime={uid:$uid,command:$command,workspace:$workspace} |
      .memory={scope:$scope,write:$write} | .toolIds=($tools|split(",")|map(select(length>0))) |
      .maxInstances=$max | .maxRunSeconds=$duration |
      .children={allowedTypes:($allowed|split(",")|map(select(length>0))),maxTotal:$total,maxConcurrent:$concurrent,maxDepth:$depth}
    ' "$work/profile" >"$work/new" || return 1
    if [[ $artifact_selected == true ]]; then
        jq --arg version "$artifact_version" --arg url "$artifact_url" --arg sha "$artifact_sha" '.runtime.codexArtifact={version:$version,url:$url,sha256:$sha}' "$work/new" >"$work/artifact" || return 1
        mv "$work/artifact" "$work/new"
        ductor_codex_artifact_validate "$work/new" || return 1
    fi
    ductor_profile_validate "$work/new" || return 1
    if ductor_ui_confirm 'Approve agent type' "Save immutable profile '$name' for $repository?\nRole: $role\nModel: $model\nResources: $cpu CPU / $ram MiB / $disk GiB\nMaximum instances: $max_instances\nChild profiles: ${allowed:-none}\n\nThe definition is retained in config.json. Live account, tool and worker checks run during apply."; then
        ductor_console_profile_save "$work/new"
    fi
)

ductor_console_profile_remove() (
    umask 077
    local name=$1 work
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-profile-remove.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    jq -e --arg name "$name" 'all(.agents[]?; .profile!=$name)' "$work/config" >/dev/null || { ductor_ui_message 'Agent type still desired' 'This profile is referenced by desired agents in config.json. Remove or migrate those declarations before removing the profile.'; return 1; }
    ductor_console_exec profiles remove "$name" || return 1
    jq --arg name "$name" '.profiles |= map(select(.name!=$name))' "$work/config" >"$work/new" || return 1
