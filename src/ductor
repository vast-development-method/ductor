  mempalace:
    image: ghcr.io/mempalace/mempalace:3.11.0@sha256:feee4ba49a76b94e897efef4b3b12450b1199e14b40262676e027ef9555afc22
    restart: unless-stopped
    init: true
    command: [mcp, --transport, http, --host, 0.0.0.0, --port, "8765"]
