    settings=$(ductor_pc_request GET /api/instance/settings/experimental) || return
    printf '%s' "$settings" | jq -e 'type == "object" and (.enableAgentChat | type == "boolean")' >/dev/null || ductor_die 'Paperclip returned an unsupported Agent Chat settings response.'
