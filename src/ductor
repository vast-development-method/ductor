        timeout 15s incus exec "$remote:$vm" --project "$project" -- systemctl stop ductor-expiry.timer >/dev/null 2>&1 || true
        # Forced stop is the cancellation boundary for all guest process trees.
        timeout 90s incus stop "$remote:$vm" --project "$project" --force >&2 || return
    fi
    [[ $(ductor_broker_location "$lease" | jq -r .state) == Stopped ]] || ductor_die 'VM termination is not confirmed.'
    jq '.state="stopped"' "$lease" | ductor_broker_write "$lease" || return
    jq '{providerLeaseId:.id,state:"stopped"}' "$lease"
}
ductor_broker_install() {
    local key=${1:-} directory=/var/lib/ductor-broker file temporary
    [[ $EUID == 0 && -f $key && ! -L $key ]] || ductor_die 'Usage: sudo ductor broker install PUBLIC_KEY_FILE'
    ductor_require_cmd ssh-keygen
    ssh-keygen -lf "$key" >/dev/null || ductor_die 'Invalid broker public key.'
    [[ $(wc -l < "$key") -le 1 && $(cat "$key") =~ ^ssh-ed25519\ [A-Za-z0-9+/=]+(\ [A-Za-z0-9._-]+)?$ ]] || ductor_die 'Use the dedicated Ductor ed25519 public key.'
