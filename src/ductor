    prefix=$(printf '%s' "$company" | jq -er --arg company "$DUCTOR_PC_COMPANY" 'select(.id == $company) | .issuePrefix | select(type == "string" and test("^[A-Za-z0-9_-]+$"))') || ductor_die 'Could not verify the company-specific conversation URL.'
    printf 'Agent Chat: %s (native Paperclip experimental feature)\n' "$(printf '%s' "$settings" | jq -r 'if .enableAgentChat then "enabled" else "disabled" end')" || return
    printf 'Talk to your team: %s/%s/chats\n' "$DUCTOR_PC_URL" "$prefix" || return
    printf 'Choose your configured secretary or coordinator. Its existing account, model, permissions, and execution capacity apply.\n' || return
