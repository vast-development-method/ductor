            [[ $(jq -r .runId "$lease") == "$run" ]] || ductor_die 'This agent already has a live lease for a different run.'
            ductor_broker_existing "$request" "$lease" execute >/dev/null || return
            requested=$(jq -r '.params.requestedExpiresAt // ""' "$request")
            if [[ -n $requested ]]; then
                deadline=$(date -d "$requested" +%s) || ductor_die 'Invalid requested lease expiry.'
