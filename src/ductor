ductor_console_connections() {
    local action name url company
    action=$(ductor_ui_menu 'Connections' 'Test readiness or authenticate through native Paperclip.' doctor 'Check infrastructure dependencies' networking 'Service networking and external reverse proxy' paperclip 'Check Paperclip operator connection' login 'Connect Paperclip with browser approval' bao-init 'Initialize OpenBao with a new private recovery file' bao-unseal 'Enter hidden OpenBao unseal shares' credentials 'Configure private OpenBao administration token' secret 'Import or version a scoped service credential' broker 'Configure verified broker SSH transport' chat 'Enable native Paperclip Agent Chat' bindings 'Verify a complete agent binding' urls 'Show service endpoints') || return 0
    case $action in
        doctor) ductor_console_run 'Infrastructure diagnostics' doctor ;;
        networking) ductor_console_network ;;
        paperclip) ductor_console_run 'Paperclip connection' paperclip status ;;
        credentials) ductor_console_credentials ;;
        bao-init) ductor_console_bao_init ;;
        bao-unseal) ductor_console_bao_unseal ;;
        secret) ductor_console_secret_import ;;
        broker) ductor_console_broker ;;
        chat) if ductor_ui_confirm 'Enable native conversation' 'Enable Paperclip Agent Chat for this company? Conversations use the approved account, model and environment of the selected agent.'; then ductor_console_run 'Enable native Paperclip Chat' paperclip conversation enable; fi ;;
        login)
            url=$(ductor_ui_input 'Paperclip connection' 'Current Paperclip origin; bootstrap may still use loopback' "$(ductor_console_paperclip_url)") || return 0
            company=$(ductor_ui_input 'Paperclip connection' 'Company UUID from Paperclip') || return 0
