      MEMPALACE_PALACE_PATH: /data/.mempalace/palace
      MEMPALACE_EMBEDDING_DEVICE: cpu
      MEMPALACE_MCP_EXTRA_ALLOWED_HOSTS: ${MEMPALACE_ALLOWED_HOSTS:-mempalace,mempalace:8765}
    networks: [memory]
    ports:
      - target: 8765
        published: "${MEMPALACE_PORT}"
        host_ip: "${MEMPALACE_BIND_ADDRESS:-127.0.0.1}"
    volumes:
      - mempalace:/data
    healthcheck:
      test: [CMD, python, -c, "import urllib.request; assert urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=5).read().strip() == b'ok'"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 60s
    logging: *logging

  contextforge-db:
    image: postgres:17.11-alpine3.24@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
