# The complete runtime is this file. Generated configuration is operator-owned state.
set +x
set -Eeuo pipefail
umask 077

DUCTOR_VERSION='0.1.0-rc.1'
DUCTOR_SOURCE_URL='https://raw.githubusercontent.com/vast-development-method/ductor/main/src/ductor'
: "${DUCTOR_STATE_DIR:=/var/lib/ductor}"
: "${DUCTOR_INSTALL_DIR:=/usr/local/bin}"
DUCTOR_SELF=${BASH_SOURCE[0]:-}
DUCTOR_ASSUME_YES=false

# Errors deliberately omit BASH_COMMAND: arguments may contain credentials.
ductor_error() {
    local result=$? line=${1:-unknown}
    printf 'Ductor: command failed (exit %s, line %s). State is retained; run ductor doctor.\n' "$result" "$line" >&2
    exit "$result"
}
ductor_log() { printf 'Ductor: %s\n' "$*" >&2; }
ductor_die() { ductor_log "$*"; exit 1; }
ductor_is_container() { [[ ${DUCTOR_CONTAINER:-0} == 1 || -f /etc/ductor-container ]]; }
if ductor_is_container; then
    # sudo intentionally resets the calling environment. Keep the Incus client
    # identity in persistent state for both operator and forced broker commands.
    export INCUS_CONF=${INCUS_CONF:-$DUCTOR_STATE_DIR/incus}
fi
ductor_host_install_only() {
    ! ductor_is_container || ductor_die 'This Ductor executable belongs to its versioned container image. Pull the selected image version and recreate the controller container; do not install packages or replace the executable inside it.'
}
ductor_require_cmd() {
    local name
    for name in "$@"; do command -v "$name" >/dev/null 2>&1 || ductor_die "Missing dependency: $name. Run ductor dependencies."; done
}
ductor_require() { ductor_require_cmd "$@"; }
ductor_confirm() {
    local answer
    if [[ $DUCTOR_ASSUME_YES == true ]]; then return 0; fi
    [[ -r /dev/tty ]] || return 1
    printf '%s [y/N] ' "$1" >/dev/tty
    IFS= read -r answer </dev/tty || return 1
    [[ $answer == [Yy] || $answer == [Yy][Ee][Ss] ]]
}
ductor_prompt() {
    local label=$1 default=${2:-} answer
    [[ -r /dev/tty ]] || ductor_die "Interactive setup needs a terminal. Use explicit CLI commands for automation."
    printf '%s%s: ' "$label" "${default:+ [$default]}" >/dev/tty
    IFS= read -r answer </dev/tty || ductor_die 'Input cancelled.'
    printf '%s' "${answer:-$default}"
}
ductor_private_dir() {
    local directory=$1
    [[ $directory == /* && $directory != / && ! -L $directory ]] || ductor_die "State directory must be an absolute, non-symlink path."
    mkdir -p -- "$directory"
    [[ $(stat -c '%u' "$directory") == "$(id -u)" ]] || ductor_die "State directory must belong to the current operator."
    chmod 700 -- "$directory"
}
ductor_state() {
    ductor_require_cmd flock stat
    ductor_private_dir "$DUCTOR_STATE_DIR"
}
ductor_lock() {
    # A kernel lock is released on process exit, including crashes. No stale PID file.
    [[ ! -L $DUCTOR_STATE_DIR/controller.lock ]] || ductor_die 'Refusing a symlinked controller lock.'
    exec 9>"$DUCTOR_STATE_DIR/controller.lock"
    flock -n 9 || ductor_die 'Another Ductor mutation is running. Retry after it completes.'
}
ductor_unlocked() { flock -u 9; exec 9>&-; }

ductor_help() {
    cat <<'HELP'
Ductor — one script for an agent infrastructure

Usage: ductor COMMAND [ARGUMENTS]
  install [--no-setup]       Install this script and start first-run setup
  setup|wizard              Configure hardware, services and credentials
  config ...                Validate, import or show desired configuration
  apply                     Reconcile the saved deployment configuration
  menu                      Open the management menu
  dependencies [--yes] [--tools-only]  Install Ubuntu/Debian dependencies
  services prepare          Generate the service stack without starting it
  services up|down|status    Manage the persistent service stack
  services urls             Show local endpoints and access guidance
  services bao-init [FILE]   Initialize OpenBao; store recovery material privately
  services bao-unseal        Enter one OpenBao unseal share privately
  services access ...        Configure authenticated team HTTPS endpoints
  services access-check      Verify TLS and service health
  services upgrade plan      Review pinned service versions supplied by this script
  services upgrade apply --backup-confirmed  Apply after backing up service data
  services ssh-credentials FILE  Provision OpenBao-managed SSH credentials
  status                    Show services, server inventory, integration state
  doctor                    Check dependencies and configuration
  nodes ...                 Register and inspect any number of Incus servers
  plan CPU MEMORY_MIB DISK_GIB  Check capacity before allocating a VM
  vm ...                    Manage Ductor-owned VMs through existing Incus remotes
  paperclip ...             Configure and register Paperclip projects/environments
  bindings ...              Provision and verify memory, tools and credential flow
  profiles ...              Manage approved agent types and delegation limits
  agents ...                Register agents using approved profiles
  provider ...              Install Paperclip native Incus lifecycle integration
  update                    Validate and atomically replace this script
