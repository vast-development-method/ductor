export function parseSpawnComment(body) {
  if (typeof body !== "string" || !body.startsWith("/ductor spawn ")) return null;
  if (body.length > 4096) throw new Error("Ductor spawn request is too large.");
  let request;
  try { request = JSON.parse(body.slice("/ductor spawn ".length)); }
  catch { throw new Error("Ductor spawn requires one JSON object with profile and name."); }
  if (!request || typeof request !== "object" || Array.isArray(request)
      || Object.keys(request).sort().join(",") !== "name,profile"
      || typeof request.profile !== "string" || !PROFILE.test(request.profile)
      || typeof request.name !== "string" || !request.name.trim() || request.name.length > 100
      || /[\u0000-\u001f\u007f]/.test(request.name)) throw new Error("Invalid Ductor spawn request.");
  return request;
}

export async function handleSpawnEvent(ctx, callBroker, event) {
  // The host supplies actor identity. A comment body can never choose its
  // parent agent, company, source issue or idempotency event identifier.
  if (event.eventType !== "issue.comment.created" || event.actorType !== "agent" || event.entityType !== "issue"
      || ![event.eventId,event.actorId,event.companyId,event.entityId,event.payload?.commentId].every(value => typeof value === "string" && UUID.test(value))) return;
  if (event.payload?.agentId && event.payload.agentId !== event.actorId) return;
  if (typeof event.payload?.bodySnippet === "string" && !event.payload.bodySnippet.startsWith("/ductor spawn ")) return;
  const comments = await ctx.issues.listComments(event.entityId, event.companyId);
  const comment = comments.find(row => row.id === event.payload.commentId);
  if (!comment || comment.authorType !== "agent" || comment.deletedAt != null || comment.authorAgentId !== event.actorId || comment.authorUserId != null
      || comment.companyId !== event.companyId || comment.issueId !== event.entityId) return;
  const request = parseSpawnComment(comment.body);
  if (!request) return;
  return callBroker("spawn", {
    companyId: event.companyId, agentId: event.actorId, eventId: event.eventId,
    issueId: event.entityId, commentId: comment.id, ...request
  });
}

export function normalizeConfig(raw = {}) {
  if (typeof raw.profile !== "string" || !PROFILE.test(raw.profile)) throw new Error("An approved Ductor profile is required.");
  const timeoutMs = raw.timeoutMs ?? 600000;
  if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1000 || timeoutMs > 86400000) throw new Error("Invalid provider timeout.");
  if (raw.reuseLease != null && typeof raw.reuseLease !== "boolean") throw new Error("Invalid lease reuse setting.");
  return { ...raw, profile: raw.profile, timeoutMs, reuseLease: raw.reuseLease ?? true };
