    outer=$(( (budget + 999)/1000 + 30 ))
    timeout 30s incus exec "$remote:$vm" --project "$project" -- install -d -m 0755 -o 0 -g 0 /run/ductor-rpc >/dev/null || return
    timeout 30s incus file push "$work/execute.json" "$remote:$vm$guest" --project "$project" --uid "$uid" --gid "$gid" --mode 0600 >/dev/null || return
