    # concurrent control calls; no controller/global lock spans this execution.
    result=0
    timeout --signal=TERM --kill-after=10s "${outer}s" incus exec "$remote:$vm" --project "$project" --user "$uid" --group "$gid" --cwd /tmp -- /usr/local/bin/ductor broker-execute "$guest" > "$work/result.json" || result=$?
    timeout 15s incus exec "$remote:$vm" --project "$project" -- rm -f -- "$guest" >/dev/null 2>&1 || true
    ((result == 0)) || return "$result"
    jq -e '.error==null and has("exitCode") and (.stdout|type=="string") and (.stderr|type=="string") and (.timedOut|type=="boolean")' "$work/result.json" >/dev/null || ductor_die 'Invalid guest execution response.'
    cat "$work/result.json"
)
ductor_broker_stop() {
    local lease=$1 location remote project vm state
    location=$(ductor_broker_location "$lease"); remote=$(jq -r .remote <<< "$location"); project=$(jq -r .project <<< "$location"); vm=$(jq -r .vm <<< "$location")
    state=$(jq -r .state <<< "$location")
