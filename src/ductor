    [[ $DUCTOR_STATE_DIR == /var/lib/ductor && $DUCTOR_INSTALL_DIR == /usr/local/bin ]] || ductor_die 'Managed broker installation requires the standard system paths.'
    if ! id ductor-broker >/dev/null 2>&1; then useradd --system --home-dir "$directory" --shell /bin/sh ductor-broker; fi
