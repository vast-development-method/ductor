ductor_console_network_form() {
    local config=$1 name key default_port address port old_address old_port url trust=false temporary
    local settings="$DUCTOR_STATE_DIR/services/settings.env"
    for name in paperclip contextforge mempalace openbao; do
        key=${name^^}
        case $name in paperclip) default_port=3100 ;; contextforge) default_port=4444 ;; mempalace) default_port=8765 ;; openbao) default_port=8200 ;; esac
        old_address=127.0.0.1; old_port=$default_port
        if [[ -f $settings && ! -L $settings ]]; then
            old_address=$(ductor_services_value "${key}_BIND_ADDRESS" "$settings") || return 1
            old_port=$(ductor_services_value "${key}_PORT" "$settings") || return 1
        fi
        address=$(jq -r --arg name "$name" --arg fallback "${old_address:-127.0.0.1}" '.services.publish[$name].bindAddress // $fallback' "$config") || return 1
        port=$(jq -r --arg name "$name" --argjson fallback "${old_port:-$default_port}" '.services.publish[$name].port // $fallback' "$config") || return 1
        address=$(ductor_ui_input 'Service networking' "$name published IPv4/IPv6 address; loopback for a same-host proxy" "$address") || return 1
        ductor_services_bind_address "$address" || { ductor_ui_message 'Invalid address' 'Enter a literal IPv4 or IPv6 address, without brackets or a hostname.'; return 1; }
        port=$(ductor_ui_budget "$name published Docker port (1024–65535)" "$port" 65535) || return 1
        ductor_services_port "$port" || return 1
        temporary=$(mktemp "${config%/*}/.network.XXXXXXXX") || return 1
        jq --arg name "$name" --arg address "$address" --argjson port "$port" '.services.publish[$name]={bindAddress:$address,port:$port}' "$config" >"$temporary" || { rm -f "$temporary"; return 1; }
        mv -f "$temporary" "$config" || return 1
    done
    for name in paperclipUrl gatewayOrigin openbaoUrl; do
        url=$(ductor_ui_input 'External reverse proxy' "$name public origin; your proxy owns TLS certificates" "$(jq -r --arg name "$name" '.services[$name]' "$config")") || return 1
        temporary=$(mktemp "${config%/*}/.network.XXXXXXXX") || return 1
        jq --arg name "$name" --arg url "${url%/}" '.services[$name]=$url' "$config" >"$temporary" || { rm -f "$temporary"; return 1; }
        mv -f "$temporary" "$config" || return 1
    done
    url=$(ductor_ui_input 'External reverse proxy' 'Optional MemPalace public HTTPS origin; blank keeps direct access local' "$(jq -r '.services.mempalaceUrl // ""' "$config")") || return 1
    if ductor_ui_confirm 'Trusted reverse proxy' 'Does exactly one trusted reverse proxy terminate Paperclip HTTPS and replace forwarded headers? Enable only when the published Paperclip port is restricted to that proxy.'; then trust=true; fi
    temporary=$(mktemp "${config%/*}/.network.XXXXXXXX") || return 1
    jq --arg memory "${url%/}" --argjson trust "$trust" '.access.managedTls=false | .access.email=(.access.email // "") | .access.trustProxy=$trust | if $memory=="" then del(.services.mempalaceUrl) else .services.mempalaceUrl=$memory end' "$config" >"$temporary" || { rm -f "$temporary"; return 1; }
    mv -f "$temporary" "$config" || return 1
    ductor_config_validate "$config"
}

ductor_console_network() (
    umask 077
    local work
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-network.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    [[ $(jq -r .role "$work/config") != worker ]] || { ductor_ui_message 'Controller setting' 'Published service ports are configured on the shared-services controller. Edit remote service URLs through setup on this worker.'; return 1; }
    ductor_console_network_form "$work/config" || return 1
    if ductor_ui_confirm 'Save service networking' 'Save these service ports and external proxy origins? Apply recreates the affected containers while preserving their data volumes.'; then
        ductor_console_exec config import "$work/config" || return 1
        if ductor_ui_confirm 'Apply service networking' 'Apply the saved configuration now?'; then ductor_console_run 'Apply service networking' apply; fi
    fi
)

ductor_console_broker() (
    umask 077
    local work
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-broker-form.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    ductor_wizard_broker "$work/config" >"$work/broker" || return 1
    jq --slurpfile broker "$work/broker" '.broker=$broker[0]' "$work/config" >"$work/new" || return 1
    ductor_console_exec config import "$work/new"
)

ductor_console_upgrade() {
    local action
    action=$(ductor_ui_menu 'Service upgrades' 'Upgrades use the pinned versions in this installed Ductor release. Database migrations may require restoring a full backup to roll back.' plan 'Show current and proposed pinned versions' apply 'Apply after a full application/database backup') || return 0
    case $action in
        plan) ductor_console_run 'Pinned service upgrade plan' services upgrade plan ;;
        apply)
            if ductor_ui_confirm 'Backup confirmation' 'Has a complete application/database/volume backup been completed and checked? A controller configuration snapshot alone cannot undo database migrations.'; then
                ductor_console_run 'Upgrade pinned services' services upgrade apply --backup-confirmed
            fi
            ;;
        *) return 1 ;;
    esac
}

ductor_console_agent_create() (
    umask 077
    local name profile parent work mode=${1:-apply}
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-agent-form.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    profile=$(ductor_ui_input 'Desired agent' 'Configured agent profile name') || return 0
    name=$(ductor_ui_input 'Desired agent' 'New agent name') || return 0
    parent=$(ductor_ui_input 'Desired agent' 'Parent agent name already declared in config.json; blank for a top-level agent') || return 0
    jq -e --arg profile "$profile" 'any(.profiles[]; .name==$profile)' "$work/config" >/dev/null || { ductor_ui_message 'Agent type required' 'Create or import this profile using Agent types before adding a desired agent.'; return 1; }
    jq --arg name "$name" --arg profile "$profile" --arg parent "$parent" '.agents=(.agents // [])+[{name:$name,profile:$profile}+(if $parent=="" then {} else {parentName:$parent} end)]' "$work/config" >"$work/new" || return 1
    ductor_config_validate "$work/new" || return 1
    if ductor_ui_confirm 'Save desired agent' "Declare '$name' with profile '$profile' and parent '${parent:-none}'? Apply registers its native Paperclip environment. Its first run starts the isolated VM and verifies its runtime bindings."; then
        ductor_console_exec config import "$work/new" || return 1
        if [[ $mode != defer ]] && ductor_ui_confirm 'Apply desired agent' 'Apply the saved deployment now?'; then ductor_console_run 'Create desired agents and environments' apply; fi
    fi
)

ductor_console() {
    local action
    while true; do
        action=$(ductor_ui_menu 'Ductor' 'Manage desired configuration and inspect actual readiness.' setup 'First run or edit configuration' status 'Services, servers and integration status' talk 'Talk to your team in native Paperclip Chat' servers 'Add, drain or remove servers' profiles 'Manage agent types' agent 'Declare an agent from an approved type' connections 'Authentication and connection tests' apply 'Apply configuration / reconcile deployment' up 'Start shared services' down 'Stop shared services; retain data' update 'Update the Ductor script' service-update 'Review/apply pinned service releases' help 'Command help' exit 'Exit') || return 0
        case $action in
            setup) ductor_console_exec wizard || ductor_log 'Setup incomplete; existing state retained.' ;;
            status) ductor_console_run 'Ductor status' status || true ;;
            talk) ductor_console_run 'Native Paperclip conversation' paperclip conversation open || true ;;
            servers) ductor_console_servers || ductor_log 'Server operation incomplete.' ;;
            profiles) ductor_console_profiles || ductor_log 'Profile operation incomplete.' ;;
            agent) ductor_console_agent_create || ductor_log 'Agent deployment incomplete; inspect its saved state.' ;;
            connections) ductor_console_connections || ductor_log 'Connection is not ready.' ;;
            apply) if ductor_ui_confirm 'Apply configuration' 'Reconcile saved configuration and verify the resulting connections?'; then ductor_console_run 'Apply configuration' apply || true; fi ;;
            up) ductor_console_run 'Start shared services' services up || true ;;
            down) if ductor_ui_confirm 'Stop shared services' 'Stop shared services? Their databases, credentials and workspaces remain on disk.'; then ductor_console_run 'Stop shared services' services down || true; fi ;;
            update) if ductor_ui_confirm 'Update Ductor' 'Download and validate the current Ductor script? Running services are upgraded separately.'; then ductor_console_run 'Update Ductor script' update || true; fi ;;
            service-update) ductor_console_upgrade || ductor_log 'Service upgrade incomplete; inspect service status.' ;;
            help) ductor_console_run 'Ductor commands' help || true ;;
            exit) return 0 ;;
            *) ductor_ui_message 'Invalid choice' 'Choose one of the menu entries.' ;;
        esac
    done
}
# Reconcile reviewed desired configuration through the existing service/native
# integration functions. A saved configuration is never a readiness assertion.
ductor_apply_root() {
    [[ $EUID == 0 ]] || ductor_die 'Applying server configuration requires root.'
}

ductor_apply_record() {
    local status=$1 phase=$2 pending=$3 destination="$DUCTOR_STATE_DIR/apply-state.json" temporary hash
    [[ ! -L $destination ]] || ductor_die 'Refusing a symlinked apply status file.'
    hash=$(sha256sum "$DUCTOR_STATE_DIR/config.json") || return 1; hash=${hash%% *}
    temporary=$(mktemp "$DUCTOR_STATE_DIR/.apply-state.XXXXXXXX") || return 1
    if ! jq -n --arg status "$status" --arg phase "$phase" --arg time "$(date -u +%FT%TZ)" --arg hash "$hash" --slurpfile pending "$pending" '{status:$status,phase:$phase,updatedAt:$time,configSha256:$hash,pending:$pending[0],liveAgentExecutionQualified:false}' >"$temporary"; then
        rm -f -- "$temporary"; return 1
    fi
    chmod 600 "$temporary" && mv -f -- "$temporary" "$destination"
}

ductor_apply_pending_add() {
    local file=$1 key=$2 message=$3 temporary
    temporary=$(mktemp "${file%/*}/.pending.XXXXXXXX") || return 1
    jq --arg key "$key" --arg message "$message" '. + [{requirement:$key,message:$message}]' "$file" >"$temporary" || { rm -f -- "$temporary"; return 1; }
    mv -f -- "$temporary" "$file"
}

ductor_apply_service_pins() (
    local dir="$DUCTOR_STATE_DIR/services" work scope name
    [[ ! -L $dir && ! -L $dir/compose.yaml ]] || ductor_die 'Service configuration must not be symlinked.'
    if [[ ! -s $dir/compose.yaml ]]; then
        [[ ! -e $dir/initialized ]] || ductor_die 'An initialized installation is missing its Compose file. Restore it before applying configuration.'
        return 0
    fi
    # Render the new bundle privately before touching the installed Compose
    # files. An apply may reconcile settings, but migrations use upgrade's
    # explicit data-backup gate, including for existing memory scopes.
    work=$(mktemp -d "$DUCTOR_STATE_DIR/.apply-pins.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    cp -a -- "$dir" "$work/services" || return 1
    DUCTOR_STATE_DIR="$work" ductor_services_prepare >/dev/null || return 1
    : >"$work/current-images"
    : >"$work/desired-images"
    for scope in "$dir/compose.yaml" "$dir"/memory/*/compose.yaml; do
        [[ -f $scope ]] || continue
        [[ ! -L $scope ]] || ductor_die 'Memory scope Compose files must not be symlinked.'
        name=${scope#"$dir/"}
        if [[ $name != compose.yaml ]]; then
            name=${name#memory/}; name=${name%/compose.yaml}
            DUCTOR_STATE_DIR="$work" ductor_services_memory_scope "$name" --prepare >/dev/null || return 1
            name="memory/$name/compose.yaml"
        fi
        awk -v scope="$name" '/^  [A-Za-z0-9_-]+:$/ {service=$1} $1=="image:" {print scope,service,$2}' "$scope" >>"$work/current-images" || return 1
        awk -v scope="$name" '/^  [A-Za-z0-9_-]+:$/ {service=$1} $1=="image:" {print scope,service,$2}' "$work/services/$name" >>"$work/desired-images" || return 1
    done
    [[ -s $work/current-images && -s $work/desired-images ]] || ductor_die 'Cannot verify the installed service image pins.'
    if ! cmp -s "$work/current-images" "$work/desired-images"; then
        ductor_log 'This Ductor bundle changes installed service image pins. Back up service data, review ductor services upgrade plan, and use ductor services upgrade apply --backup-confirmed before retrying apply.'
        return 1
    fi
)

ductor_apply_services() {
    local config=$1 settings="$DUCTOR_STATE_DIR/services/settings.env" paperclip domain
    domain=$(jq -r '.identity.emailDomain // ""' "$config") || return 1
    paperclip="http://localhost:${DUCTOR_PAPERCLIP_PORT:-3100}"
    if [[ -f $settings ]]; then
        paperclip=$(ductor_services_value PAPERCLIP_PUBLIC_URL "$settings") || return 1
    elif [[ $(jq -r '.access.managedTls // false' "$config") == false ]]; then
        # A fresh external-proxy installation owns its canonical origin from
        # the first native account claim, including custom published ports.
        paperclip=$(jq -r .services.paperclipUrl "$config") || return 1
    fi
    # ContextForge creates its administrator on initial database bootstrap.
    # Only that first bootstrap uses this email; changing it cannot rename a DB user.
    # Retain established origins until native ownership and TLS checks succeed.
    # Managed TLS starts privately; an external proxy uses its declared origin.
    DUCTOR_PAPERCLIP_URL="$paperclip" DUCTOR_ADMIN_EMAIL="admin@$domain" ductor_apply_service_pins || return 1
    DUCTOR_PAPERCLIP_URL="$paperclip" DUCTOR_ADMIN_EMAIL="admin@$domain" ductor_services_prepare || return 1
    ductor_apply_service_network "$config" "$settings" || return 1
    if [[ $(jq -r '.access.managedTls // false' "$config") == false && -f $DUCTOR_STATE_DIR/services/Caddyfile ]]; then
        ductor_services_compose stop caddy || return 1
        mv -- "$DUCTOR_STATE_DIR/services/Caddyfile" "$DUCTOR_STATE_DIR/services/Caddyfile.disabled.$(date -u +%Y%m%dT%H%M%S)" || return 1
    fi
    ductor_services_up
}

ductor_apply_service_network() (
    umask 077
    local config=$1 destination=$2 settings name key address port host public
    local -A published_ports_seen=()
    settings=$(mktemp "${destination%/*}/.network-settings.XXXXXXXX") || return 1
    trap 'rm -f -- "$settings"' EXIT
    cp -- "$destination" "$settings" || return 1
    if [[ $(jq -r '.access.trustProxy // false' "$config") == true ]]; then
        ductor_services_setting_set PAPERCLIP_TRUST_PROXY 1 "$settings" || return 1
    elif [[ $(jq -r '.access.managedTls // false' "$config") != true ]]; then
        ductor_services_setting_set PAPERCLIP_TRUST_PROXY false "$settings" || return 1
    fi
    # A missing publication block means keep the existing release's bindings.
    while IFS=$'\t' read -r name address port; do
        [[ -n $name ]] || continue
        key=${name^^}
        ductor_services_bind_address "$address" && ductor_services_port "$port" || return 1
        ductor_services_setting_set "${key}_BIND_ADDRESS" "$address" "$settings" || return 1
        ductor_services_setting_set "${key}_PORT" "$port" "$settings" || return 1
    done < <(jq -r '.services.publish // {} | to_entries[] | [.key,.value.bindAddress,(.value.port|tostring)] | @tsv' "$config")
    public=$(jq -r '.services.paperclipUrl' "$config") || return 1
    host=${public#*://}; host=${host%%:*}
    [[ $public != *'['* ]] || { host=${public#*\[}; host=${host%%\]*}; }
    address=$(ductor_services_value PAPERCLIP_BIND_ADDRESS "$settings") || return 1
    ductor_services_setting_set PAPERCLIP_ALLOWED_HOSTNAMES "localhost,127.0.0.1,::1,$host,${address:-127.0.0.1}" "$settings" || return 1
    public=$(jq -r '.services.mempalaceUrl // ""' "$config") || return 1
    if [[ -n $public ]]; then
        host=${public#*://}
        ductor_services_setting_set MEMPALACE_PUBLIC_URL "$public" "$settings" || return 1
        ductor_services_setting_set MEMPALACE_ALLOWED_HOSTS "mempalace,mempalace:8765,$host" "$settings" || return 1
    else
        ductor_services_setting_set MEMPALACE_PUBLIC_URL '' "$settings" || return 1
        ductor_services_setting_set MEMPALACE_ALLOWED_HOSTS 'mempalace,mempalace:8765' "$settings" || return 1
    fi
    for key in PAPERCLIP CONTEXTFORGE MEMPALACE OPENBAO; do
        port=$(ductor_services_value "${key}_PORT" "$settings") || return 1
        # Older fixture/config files are completed by services prepare.
        [[ -n $port ]] || continue
        ductor_services_port "$port" || return 1
        [[ -z ${published_ports_seen[$port]:-} ]] || { ductor_log 'Each service needs a distinct published port.'; return 1; }
        published_ports_seen[$port]=$key
    done
    chmod 600 "$settings" && mv -f -- "$settings" "$destination"
)

ductor_apply_access() {
    local config=$1 work=$2 settings="$DUCTOR_STATE_DIR/services/settings.env" paperclip forge bao email host url path index bootstrap_url
    local -a origins=() hosts=()
    paperclip=$(jq -r .services.paperclipUrl "$config") || return 1
    forge=$(jq -r .services.gatewayOrigin "$config") || return 1
    bao=$(jq -r .services.openbaoUrl "$config") || return 1
    bootstrap_url=$DUCTOR_PC_URL
    if [[ $(jq -r '.access.managedTls // false' "$config") == true ]]; then
        email=$(jq -r .access.email "$config") || return 1
        for url in "$paperclip" "$forge" "$bao"; do
            [[ $url =~ ^https://([A-Za-z0-9][A-Za-z0-9.-]*)$ ]] || { ductor_log 'Managed TLS requires three HTTPS DNS origins on the default port, without paths or explicit ports.'; return 1; }
            hosts+=("${BASH_REMATCH[1]}")
        done
        ductor_services_access --paperclip-host "${hosts[0]}" --gateway-host "${hosts[1]}" --bao-host "${hosts[2]}" --email "$email" || return 1
    else
        # An external TLS proxy is an explicit operator choice. Verify all
        # desired endpoints before changing canonical origins; never use -k.
        ductor_require_cmd curl
        origins=("$paperclip/api/health" "$forge/health" "$bao/v1/sys/seal-status")
        for index in 0 1 2; do
            url=${origins[index]}; path="$work/endpoint-$index.json"
            if ! curl -q --silent --show-error --fail --proto '=http,https' --connect-timeout 10 --max-time 30 --max-filesize 1048576 "$url" >"$path"; then
                ductor_log 'A desired service origin is unavailable. Configure its external TLS proxy, or enable managed TLS, and apply again.'
                return 1
            fi
            jq -e 'type=="object"' "$path" >/dev/null || { ductor_log 'A service origin did not return the expected health response.'; return 1; }
        done
        jq -e 'has("initialized") and has("sealed")' "$work/endpoint-2.json" >/dev/null || { ductor_log 'The OpenBao origin did not return its seal status.'; return 1; }
        # A board key for the configured company must work at the desired
        # Paperclip origin before any URL or authentication state is replaced.
        DUCTOR_PC_URL=$paperclip
        ductor_pc_operator admin || return 1
        ductor_apply_service_origins "$paperclip" "$forge" "$bao" "$settings" || return 1
        if [[ $(jq -r '.access.trustProxy // false' "$config") == true ]]; then
            ductor_services_setting_set PAPERCLIP_TRUST_PROXY 1 "$settings" || return 1
        else
            ductor_services_setting_set PAPERCLIP_TRUST_PROXY false "$settings" || return 1
        fi
        ductor_services_compose up -d --no-deps --wait --wait-timeout 120 paperclip contextforge || return 1
    fi
    DUCTOR_PC_URL=$paperclip
    ductor_pc_operator admin || return 1
    if [[ $bootstrap_url != "$paperclip" ]]; then
        jq -r .token "$DUCTOR_STATE_DIR/paperclip/connection.json" >"$work/operator-token" || return 1
        chmod 600 "$work/operator-token" || return 1
        ductor_pc_save_connection "$paperclip" "$DUCTOR_PC_COMPANY" "$work/operator-token" || return 1
    fi
}

ductor_apply_service_origins() {
    local paperclip=$1 forge=$2 bao=$3 settings=$4 host address
    host=${paperclip#*://}
    if [[ $host == \[* ]]; then host=${host#\[}; host=${host%%\]*}; else host=${host%%:*}; fi
    ductor_services_setting_set PAPERCLIP_PUBLIC_URL "$paperclip" "$settings" || return 1
    ductor_services_setting_set CONTEXTFORGE_PUBLIC_URL "$forge" "$settings" || return 1
    ductor_services_setting_set OPENBAO_PUBLIC_URL "$bao" "$settings" || return 1
    address=$(ductor_services_value PAPERCLIP_BIND_ADDRESS "$settings") || return 1
    ductor_services_setting_set PAPERCLIP_ALLOWED_HOSTNAMES "localhost,127.0.0.1,::1,$host,${address:-127.0.0.1}" "$settings" || return 1
    if [[ $forge == https://* ]]; then
        ductor_services_setting_set CONTEXTFORGE_SECURE_COOKIES true "$settings" || return 1
    else
        ductor_services_setting_set CONTEXTFORGE_SECURE_COOKIES false "$settings" || return 1
    fi
}

ductor_apply_nodes() {
    local config=$1 work=$2 index count id enabled previous
    local -a arguments=()
    jq '.profiles' "$config" >"$work/desired-profiles.json" || return 1
    count=$(jq '.nodes|length' "$config") || return 1
    for ((index=0;index<count;index++)); do
        jq --argjson index "$index" '.nodes[$index]' "$config" >"$work/node.json" || return 1
        id=$(jq -r .id "$work/node.json") || return 1
        enabled=$(jq -r 'if has("enabled") then .enabled else true end' "$work/node.json") || return 1
        previous=''
        if [[ -f $DUCTOR_STATE_DIR/inventory.json ]]; then
            previous=$(jq -c --arg id "$id" '.nodes[]? | select(.id==$id)' "$DUCTOR_STATE_DIR/inventory.json") || return 1
        fi
        if [[ $enabled == false && -n $previous ]]; then
            # Draining must still work if a server is offline. Compare desired
            # identity/budgets first; never use drain as a way to hide drift.
            jq -e --argjson old "$previous" '{id,remote,project,profile:(.profiles|join(",")),pool,role,cpu,memory_mib:.memoryMiB,disk_gib:.diskGiB,max_agents:.maxAgents} == ($old|del(.identity,.enabled))' "$work/node.json" >/dev/null || { ductor_log "Node $id differs from its stored inventory; review its placements before changing capacity or identity."; return 1; }
            ductor_nodes drain "$id" || return 1
            continue
        fi
        if [[ -n $(jq -r '.sourceProject // ""' "$work/node.json") ]]; then
            ductor_platform_prepare_node "$work/node.json" "$work/desired-profiles.json" || return 1
        fi
        arguments=()
        while IFS= read -r previous; do arguments+=("$previous"); done < <(jq -r '.id,.remote,.cpu,.memoryMiB,.diskGiB,.maxAgents,.project,(.profiles|join(",")),.pool,.role' "$work/node.json")
        ductor_nodes add "${arguments[@]}" || return 1
        if [[ $enabled == true ]]; then ductor_nodes enable "$id" || return 1; else ductor_nodes drain "$id" || return 1; fi
    done
}

ductor_apply_profiles() {
    local config=$1 work=$2 index count
    count=$(jq '.profiles|length' "$config") || return 1
    for ((index=0;index<count;index++)); do
        jq --argjson index "$index" '.profiles[$index]' "$config" >"$work/profile.json" || return 1
        ductor_profiles import "$work/profile.json" || return 1
    done
}

ductor_apply_broker_identity() {
    local config=$1 host port known user local_key line type key matched=false key_match
    host=$(jq -r .broker.host "$config") || return 1
    port=$(jq -r .broker.port "$config") || return 1
    known=$(jq -r .broker.knownHostsFile "$config") || return 1
    user=$(jq -r .broker.user "$config") || return 1
    [[ $user == ductor-broker ]] || { ductor_log 'Automatic broker installation uses the dedicated ductor-broker account. Configure this account in broker.user.'; return 1; }
    [[ -f $known && ! -L $known && -s $known ]] || { ductor_log 'Provide independently verified broker host keys before applying the provider connection.'; return 1; }
    [[ $port == 22 ]] || host="[$host]:$port"
    # This installer configures the broker on this controller. A known host key
    # for a different machine would otherwise authorize the wrong controller.
    while IFS= read -r line; do
        [[ $line != \#* ]] || continue
        read -r _ type key _ <<<"$line"
        [[ -n $type && -n $key ]] || continue
        key_match=false
        while IFS= read -r local_key; do
            [[ -f $local_key && ! -L $local_key ]] || continue
            if [[ $(awk '{print $1 " " $2}' "$local_key") == "$type $key" ]]; then matched=true; key_match=true; fi
        done < <(ductor_broker_host_key_files)
        $key_match || { ductor_log 'A broker host key belongs to a different machine. Keep only verified SSH host keys belonging to this controller.'; return 1; }
    done < <(ssh-keygen -F "$host" -f "$known")
    $matched || { ductor_log 'The configured broker host key does not match this controller. Install the broker on its actual controller or supply the verified SSH host key for this controller.'; return 1; }
}

ductor_apply_agents() {
    local config=$1 work=$2 count index name type parent_name parent_id matches profile agent_id environment
    local -a arguments=()
    count=$(jq '(.agents // [])|length' "$config") || return 1
    for ((index=0;index<count;index++)); do
        jq --argjson index "$index" '.agents[$index]' "$config" >"$work/desired-agent.json" || return 1
        name=$(jq -r .name "$work/desired-agent.json") || return 1
        type=$(jq -r .profile "$work/desired-agent.json") || return 1
        parent_name=$(jq -r '.parentName // ""' "$work/desired-agent.json") || return 1
        profile=$(ductor_profile_file "$type") || return 1
        ductor_profile_connection "$profile" "$work" || return 1
        ductor_pc_request GET "/api/companies/$DUCTOR_PC_COMPANY/agents" >"$work/agents.json" || return 1
        parent_id=''
        if [[ -n $parent_name ]]; then
            parent_id=$(jq -er --arg name "$parent_name" '[.[]|select(.name==$name and .metadata.managedBy=="ductor" and .status!="terminated")] | if length==1 then .[0].id else error("Parent not found") end' "$work/agents.json") || { ductor_log "Agent $name requires parent $parent_name. Put parent agents first in config.agents."; return 1; }
        fi
        jq --arg name "$name" '[.[]|select(.name==$name)]' "$work/agents.json" >"$work/matches.json" || return 1
        matches=$(jq length "$work/matches.json") || return 1
        if [[ $matches == 0 ]]; then
            arguments=(--profile "$type" --name "$name")
            [[ -z $parent_id ]] || arguments+=(--parent "$parent_id")
            ductor_agents_create "${arguments[@]}" >"$work/created-agent.json" || return 1
        elif [[ $matches == 1 ]]; then
            # Matching editable Paperclip metadata is insufficient authority.
            # Reuse only an identity admitted by the trusted controller registry.
            jq '.[0]' "$work/matches.json" >"$work/existing-agent.json" || return 1
            ductor_agent_registry_check "$work/existing-agent.json" "$profile" || return 1
            jq -e --slurpfile p "$profile" --arg parent "$parent_id" '.[0] | .metadata.managedBy=="ductor" and .metadata.ductorProfile==$p[0].name and .metadata.repository==$p[0].repository and .role==$p[0].role and (.reportsTo // "")==$parent and .status!="terminated" and .adapterType=="codex_local" and .adapterConfig.command=="/usr/local/bin/ductor-runtime" and .adapterConfig.model==$p[0].model and .adapterConfig.cwd==$p[0].runtime.workspace and .adapterConfig.timeoutSec==$p[0].maxRunSeconds and .adapterConfig.dangerouslyBypassApprovalsAndSandbox==false and .runtimeConfig.aiConnection.mode=="shared" and .runtimeConfig.aiConnection.provider=="openai" and .runtimeConfig.aiConnection.method=="subscription" and .runtimeConfig.aiConnection.connectionId==$p[0].connectionId and .runtimeConfig.aiConnection.grantId==$p[0].grantId and .permissions.canCreateAgents==false and .permissions.canCreateSkills==false and (.defaultEnvironmentId|type=="string")' "$work/matches.json" >/dev/null || { ductor_log "Existing agent $name differs from its desired profile or parent. Review it in Paperclip; apply will not silently overwrite its identity or permissions."; return 1; }
            agent_id=$(jq -r '.[0].id' "$work/matches.json") || return 1
            jq -e --arg binding "agent-${agent_id//-/}" '.[0] | .metadata.binding==$binding and .adapterConfig.env.DUCTOR_BINDING_NAME==$binding' "$work/matches.json" >/dev/null || { ductor_log "Existing agent $name has an incomplete runtime binding. Resolve the interrupted registration before applying again."; return 1; }
            environment=$(jq -r '.[0].defaultEnvironmentId' "$work/matches.json") || return 1
            ductor_pc_uuid "$environment"
            ductor_pc_request GET "/api/environments/$environment" >"$work/environment.json" || return 1
            jq -e --arg profile "$type" '.metadata.managedBy=="ductor" and .driver=="sandbox" and .status=="active" and .config.provider=="ductor-incus" and .config.profile==$profile' "$work/environment.json" >/dev/null || { ductor_log "Existing agent $name is attached to a different execution environment."; return 1; }
            ductor_log "Agent $name matches its desired profile."
        else
            ductor_log "More than one Paperclip agent is named $name; resolve the ambiguity before applying."
            return 1
        fi
    done
}

ductor_apply() (
    set +x
    umask 077
    local check=false config="$DUCTOR_STATE_DIR/config.json" work role index count domain token broker_host broker_user broker_port known phase=validation status=applying result
    if [[ ${1:-} == --check && $# == 1 ]]; then check=true; elif (($#)); then ductor_die 'Usage: ductor apply [--check]'; fi
    ductor_require_cmd jq sha256sum
    ductor_config_validate "$config" || return 1
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-apply.XXXXXXXX") || return 1
    printf '[]\n' >"$work/pending.json" || return 1
    trap 'result=$?; if [[ $status == applying && $check == false ]]; then ductor_apply_record failed "$phase" "$work/pending.json" || true; fi; rm -rf -- "$work"; exit "$result"' EXIT
    jq -e '.profiles|map(.name)|length==(unique|length)' "$config" >/dev/null || ductor_die 'Desired agent profiles must have unique names.'
    count=$(jq '.profiles|length' "$config") || return 1
    for ((index=0;index<count;index++)); do
        jq --argjson index "$index" '.profiles[$index]' "$config" >"$work/profile.json" || return 1
        ductor_profile_validate "$work/profile.json" || return 1
    done
    role=$(jq -r .role "$config") || return 1
    if $check; then
        status=validated
        jq '{status:"validated",liveServicesChecked:false,role,nodes:(.nodes|length),profiles:(.profiles|length),agents:((.agents // [])|length)}' "$config"
        return 0
    fi
    ductor_apply_root || return 1
    ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    domain=$(jq -r '.identity.emailDomain // ""' "$config") || return 1
    if [[ $role != worker && -z $domain ]]; then
        ductor_apply_pending_add "$work/pending.json" identity.emailDomain 'Configure your real email domain before the first ContextForge administrator is created.' || return 1
    fi
    if [[ $(jq length "$work/pending.json") != 0 ]]; then
        status=pending
        ductor_apply_record "$status" prerequisites "$work/pending.json" || return 1
        jq . "$DUCTOR_STATE_DIR/apply-state.json"
        return 1
    fi
    if [[ $role != worker ]]; then
        phase=services; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
        ductor_apply_services "$config" || return 1
    fi
    phase=nodes; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_apply_nodes "$config" "$work" || return 1
    phase=profiles; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_apply_profiles "$config" "$work" || return 1
    if [[ $role == worker ]]; then
        status=worker-configured
        ductor_apply_record "$status" complete "$work/pending.json" || return 1
        jq . "$DUCTOR_STATE_DIR/apply-state.json"
        ductor_log 'Worker inventory and profiles are configured. Register this Incus remote with the controller to admit Paperclip work.'
        return 0
    fi
    phase=prerequisites
    [[ -f $DUCTOR_STATE_DIR/paperclip/connection.json && ! -L $DUCTOR_STATE_DIR/paperclip/connection.json ]] || ductor_apply_pending_add "$work/pending.json" paperclip.operator 'Complete native Paperclip login for this company, then run ductor apply again.' || return 1
    token=$(jq -r '.credentials.openbaoAdminTokenFile // ""' "$config") || return 1
    [[ -n $token && -f $token && ! -L $token ]] || ductor_apply_pending_add "$work/pending.json" credentials.openbaoAdminTokenFile 'Initialize and unseal OpenBao, then configure its private administrator token file.' || return 1
    broker_host=$(jq -r '.broker.host // ""' "$config") || return 1
    broker_user=$(jq -r '.broker.user // "ductor-broker"' "$config") || return 1
    broker_port=$(jq -r '.broker.port // 22' "$config") || return 1
    known=$(jq -r '.broker.knownHostsFile // ""' "$config") || return 1
    [[ -n $broker_host && -n $known && -f $known && ! -L $known ]] || ductor_apply_pending_add "$work/pending.json" broker 'Configure the controller SSH host, ductor-broker user, port and independently verified known-hosts file.' || return 1
    [[ $(jq '[.nodes[]|select(.enabled!=false)]|length' "$config") != 0 ]] || ductor_apply_pending_add "$work/pending.json" nodes 'Configure at least one enabled, capacity-limited Incus execution node.' || return 1
    [[ $(jq '.profiles|length' "$config") != 0 ]] || ductor_apply_pending_add "$work/pending.json" profiles 'Import at least one reviewed agent type with an exact model, connection grant and platform image.' || return 1
    if [[ $(jq length "$work/pending.json") != 0 ]]; then
        status=pending
        ductor_apply_record "$status" "$phase" "$work/pending.json" || return 1
        jq . "$DUCTOR_STATE_DIR/apply-state.json"
        ductor_log 'Bootstrap services remain available. Complete the listed prerequisites and rerun apply.'
        return 1
    fi
    phase=authentication; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_pc_private_file "$token" || return 1
    ductor_pc_load || return 1
    ductor_pc_operator admin || return 1
    [[ $DUCTOR_PC_URL == "$(jq -r .services.paperclipUrl "$config")" || $DUCTOR_PC_URL == "$(ductor_services_value PAPERCLIP_PUBLIC_URL "$DUCTOR_STATE_DIR/services/settings.env")" ]] || { ductor_log 'Saved Paperclip authentication uses a different origin. Sign in to the current bootstrap origin before applying.'; return 1; }
    phase=access; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_apply_access "$config" "$work" || return 1
    ductor_pc_load || return 1
    phase=credentials; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_services_ssh_credentials "$token" || return 1
    phase=broker; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_apply_broker_identity "$config" || return 1
    ductor_broker_install "$DUCTOR_STATE_DIR/services/ssh-agent/id_ed25519.pub" || return 1
    phase=provider; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_provider_prepare --host "$broker_host" --user "$broker_user" --port "$broker_port" --known-hosts "$known" || return 1
    ductor_provider_install >"$work/provider.json" || return 1
    phase=agents; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
    ductor_apply_agents "$config" "$work" || return 1
    if [[ $(jq -r 'if .conversation.enabled == false then false else true end' "$config") == true ]]; then
        phase=conversation; ductor_apply_record applying "$phase" "$work/pending.json" || return 1
        ductor_paperclip_conversation enable >"$work/conversation.json" || return 1
    fi
    status=configured
    ductor_apply_record "$status" complete "$work/pending.json" || return 1
    jq . "$DUCTOR_STATE_DIR/apply-state.json"
    ductor_log 'Desired configuration applied. First-task qualification is still required: no model request or VM execution was performed by apply.'
)
# CLI dispatch is last so a downloaded script can define all functions before setup.
ductor_main() {
    local command=${1:-} action
    if [[ ${0##*/} == ductor-runtime ]]; then ductor_runtime "$@"; return; fi
    (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )) || ductor_die 'Bash 4.4 or newer is required.'
    trap 'ductor_error "$LINENO"' ERR
    case $command in
        help|-h|--help) ductor_help; return ;;
        version|--version) printf 'Ductor %s\n' "$DUCTOR_VERSION"; return ;;
    esac
    [[ $(uname -s) == Linux ]] || ductor_die 'Ductor currently supports Linux servers.'
    if [[ -z $command ]]; then
        if [[ -z $DUCTOR_SELF || $DUCTOR_SELF == /dev/* || -n ${BASH_EXECUTION_STRING:-} ]]; then command=install; else command=menu; fi
    else shift
    fi
    case $command in
        install) ductor_install "$@"; return ;;
        dependencies) ductor_dependencies "$@"; return ;;
        runtime) ductor_runtime "$@"; return ;;
        broker-execute) [[ $# == 1 ]] || ductor_die "Usage: broker-execute REQUEST_FILE"; ductor_guest_execute "$1"; return ;;
    esac
    ductor_state
    # Read-only probes do not hold the controller lock. Mutations serialize across
    # menu, installer, CLI and integrations on this controller host.
    case "$command:${1:-}" in
        setup:*|wizard:*|console:*|broker:*|menu:*|doctor:*|status:*|serve:*|container-health:*|container-status:*|plan:*|services:status|services:urls|nodes:list|nodes:probe|nodes:help|vm:list|vm:help|paperclip:status|paperclip:projects|paperclip:agents|paperclip:environments|paperclip:models|paperclip:help|bindings:check|bindings:help) ;;
        *) ductor_lock ;;
    esac
    case $command in
        setup|wizard) [[ $# == 0 ]] || ductor_die 'Usage: ductor setup'; ductor_wizard ;;
        menu|console) [[ $# == 0 ]] || ductor_die 'Usage: ductor menu'; ductor_console ;;
        services)
            action=${1:-status}; [[ $# == 0 ]] || shift
            case $action in
                prepare) ductor_services_prepare "$@" ;;
                up) ductor_services_up "$@" ;;
                down) ductor_services_down "$@" ;;
                status) ductor_services_status "$@" ;;
                urls) ductor_services_urls "$@" ;;
                bao-init) ductor_services_bao_init "$@" ;;
                bao-unseal) ductor_services_bao_unseal "$@" ;;
                memory-scope) ductor_services_memory_scope "$@" ;;
                ssh-credentials) ductor_services_ssh_credentials "$@" ;;
                ssh-ready) ductor_services_ssh_ready "$@" ;;
                secret-import) ductor_services_secret_import "$@" ;;
                access) ductor_services_access "$@" ;;
                access-check) ductor_services_access_check "$@" ;;
                upgrade) ductor_services_upgrade "$@" ;;
                *) ductor_die 'Unknown services command. Use prepare, up, down, status, urls, bao-init, bao-unseal, or memory-scope.' ;;
            esac
            ;;
        nodes) ductor_nodes "$@" ;;
        plan) ductor_plan "$@" ;;
        vm) ductor_vm "$@" ;;
        paperclip) ductor_paperclip "$@" ;;
        bindings) ductor_bindings "$@" ;;
        provider) ductor_provider "$@" ;;
        profiles) ductor_profiles "$@" ;;
        agents) ductor_agents "$@" ;;
        broker) ductor_broker "$@" ;;
        serve) [[ $# == 0 ]] || ductor_die 'Usage: ductor serve'; ductor_container_serve ;;
        container-health) [[ $# == 0 ]] || ductor_die 'Usage: ductor container-health'; ductor_container_health ;;
        container-status) [[ $# == 0 ]] || ductor_die 'Usage: ductor container-status'; ductor_container_status ;;
        config) ductor_config "$@" ;;
        apply) ductor_apply "$@" ;;
        status)
            [[ $# == 0 ]] || ductor_die 'Usage: ductor status'
            if [[ -f $DUCTOR_STATE_DIR/apply-state.json ]]; then jq . "$DUCTOR_STATE_DIR/apply-state.json"; fi
            ductor_services_status || true
            if [[ -f $DUCTOR_STATE_DIR/inventory.json ]]; then ductor_nodes list; fi
            ductor_services_urls || true
            ;;
        doctor) [[ $# == 0 ]] || ductor_die 'Usage: ductor doctor'; ductor_doctor ;;
        update) [[ $# == 0 ]] || ductor_die 'Usage: ductor update'; ductor_update ;;
        uninstall) [[ $# == 0 ]] || ductor_die 'Usage: ductor uninstall'; ductor_uninstall ;;
        *) ductor_die "Unknown command: $command. Run ductor help." ;;
    esac
}
if [[ ${BASH_SOURCE[0]:-} == "$0" || -z ${BASH_SOURCE[0]:-} ]]; then ductor_main "$@"; fi
