        jq -e --arg agent "$agent" --arg company "$company" --arg env "$environment" --arg name "$name" '.agentId==$agent and .companyId==$company and .environmentId==$env and .profile==$name' "$lease" >/dev/null || ductor_die 'Persisted lease ownership changed.'
