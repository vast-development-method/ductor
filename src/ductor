  paperclip:
    image: ghcr.io/paperclipai/paperclip:2026.1012.0@sha256:1661b3dd3fdf7a9b59542d1ced464c3faf9dc8309798b4d15a9923ed32795307
    restart: unless-stopped
    pids_limit: 2048
    environment:
      DATABASE_URL: postgres://paperclip:${PAPERCLIP_DB_PASSWORD:?missing secret}@paperclip-db:5432/paperclip
      HOST: 0.0.0.0
