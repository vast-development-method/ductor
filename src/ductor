}

ductor_dependencies() {
    ductor_host_install_only
    local tools_only=false
    while [[ $# -gt 0 ]]; do
        case $1 in --yes) DUCTOR_ASSUME_YES=true ;; --tools-only) tools_only=true ;; *) ductor_die 'Usage: ductor dependencies [--yes] [--tools-only]' ;; esac
        shift
    done
    [[ $(uname -s) == Linux ]] || ductor_die 'Ductor targets Linux servers.'
    ductor_require_cmd apt-get
    [[ $EUID -eq 0 ]] || ductor_die 'Run dependencies with sudo.'
    ductor_confirm 'Install Bash utilities and missing Docker packages from your configured APT repositories?' || return 0
    apt-get update
    apt-get install -y ca-certificates curl jq openssl openssh-client git util-linux coreutils whiptail
    if [[ $tools_only == true ]]; then return 0; fi
    apt-get install -y sudo openssh-server
    if ! command -v docker >/dev/null 2>&1; then
        apt-get install -y docker.io
    fi
    if ! docker compose version >/dev/null 2>&1; then
        if apt-cache show docker-compose-v2 >/dev/null 2>&1; then
            apt-get install -y docker-compose-v2
        elif apt-cache show docker-compose-plugin >/dev/null 2>&1; then
            apt-get install -y docker-compose-plugin
        else
            ductor_die 'No Compose v2 package is available. Configure the official Docker repository for your distribution, then retry. Existing Docker packages are retained.'
        fi
    fi
    if command -v systemctl >/dev/null 2>&1; then systemctl enable --now docker; fi
    docker compose version >/dev/null
    ductor_log 'Dependencies are ready. No Incus repository or firewall was changed.'
}

ductor_install() {
    ductor_host_install_only
    local setup=true temporary target source_url=$DUCTOR_SOURCE_URL
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-setup) setup=false ;;
            --source-url) [[ $# -ge 2 ]] || ductor_die '--source-url needs a URL'; source_url=$2; shift ;;
            *) ductor_die 'Usage: install [--no-setup] [--source-url HTTPS_URL]' ;;
        esac
        shift
    done
    [[ $DUCTOR_INSTALL_DIR == /* && $DUCTOR_INSTALL_DIR != / && ! -L $DUCTOR_INSTALL_DIR ]] || ductor_die 'Installation directory must be an absolute, non-symlink path.'
    mkdir -p -- "$DUCTOR_INSTALL_DIR"
    target=$DUCTOR_INSTALL_DIR/ductor
    [[ ! -L $target ]] || ductor_die 'Refusing to replace a symlinked executable.'
    temporary=$(mktemp "$DUCTOR_INSTALL_DIR/.ductor-install.XXXXXX")
    if [[ -n ${BASH_EXECUTION_STRING:-} && ${BASH_EXECUTION_STRING:-} == *'# DUCTOR_SINGLE_FILE'* ]]; then
        printf '%s\n' "$BASH_EXECUTION_STRING" >"$temporary"
    elif [[ -n $DUCTOR_SELF && -f $DUCTOR_SELF && $DUCTOR_SELF != /dev/* && $DUCTOR_SELF != /proc/* ]]; then
        cat -- "$DUCTOR_SELF" >"$temporary"
    else
        [[ $source_url == https://* ]] || ductor_die 'Installer source must use HTTPS.'
        ductor_require_cmd curl
        if ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 180 "$source_url" -o "$temporary"; then
            rm -f -- "$temporary"; ductor_die 'Download failed; the installed script was not changed.'
        fi
    fi
    if ! bash -n "$temporary" || ! grep -q '^# DUCTOR_SINGLE_FILE$' "$temporary"; then
        rm -f -- "$temporary"; ductor_die 'The installer was not a valid Ductor script.'
    fi
    chmod 755 -- "$temporary"
    mv -f -- "$temporary" "$target"
    ductor_log "Installed $target"
    if [[ $setup == true ]]; then exec "$target" setup; fi
}

ductor_update() {
    ductor_host_install_only
    local temporary target=$DUCTOR_INSTALL_DIR/ductor
    ductor_require_cmd curl
    [[ -f $target && ! -L $target ]] || ductor_die 'Install Ductor before updating it.'
    temporary=$(mktemp "$DUCTOR_INSTALL_DIR/.ductor-update.XXXXXX")
    if ! curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 180 "$DUCTOR_SOURCE_URL" -o "$temporary"; then
        rm -f -- "$temporary"; ductor_die 'Update download failed; current executable retained.'
    fi
    if ! bash -n "$temporary" || ! grep -q '^# DUCTOR_SINGLE_FILE$' "$temporary"; then
        rm -f -- "$temporary"; ductor_die 'Invalid update; current executable retained.'
    fi
    chmod 755 -- "$temporary"
    [[ ! -L $DUCTOR_INSTALL_DIR/ductor.previous ]] || ductor_die 'Refusing a symlinked update backup.'
    cp -- "$target" "$DUCTOR_INSTALL_DIR/ductor.previous"
    mv -f -- "$temporary" "$target"
    ductor_log 'Script updated. Services and stored credentials were not changed.'
    "$target" version
}

ductor_uninstall() {
    ductor_host_install_only
    local target=$DUCTOR_INSTALL_DIR/ductor
    [[ -f $target && ! -L $target ]] || ductor_die 'No installed Ductor executable found.'
    ductor_confirm 'Remove the Ductor executable? Services, VMs, configuration and credentials will remain.' || return 0
    rm -f -- "$target"
    ductor_log 'Executable removed. All service data and virtual machines were retained.'
}

ductor_doctor() {
    local failed=0 dependency role=control role_file=$DUCTOR_STATE_DIR/config.json
    [[ -f $role_file ]] || role_file=$DUCTOR_STATE_DIR/setup.json
    if [[ -f $role_file ]] && command -v jq >/dev/null 2>&1; then
        role=$(jq -er '.role' "$role_file") || return
    fi
    printf 'Ductor %s\nState: %s\n\n' "$DUCTOR_VERSION" "$DUCTOR_STATE_DIR"
    for dependency in bash curl jq openssl ssh flock git; do
        if command -v "$dependency" >/dev/null 2>&1; then printf 'OK       %s\n' "$dependency"; else printf 'MISSING  %s\n' "$dependency"; failed=1; fi
    done
    if [[ $role != worker ]] && command -v docker >/dev/null 2>&1; then
        if docker compose version >/dev/null 2>&1; then printf 'OK       Docker Compose v2\n'; else printf 'MISSING  Docker Compose v2\n'; failed=1; fi
        if docker info >/dev/null 2>&1; then printf 'OK       Docker daemon access\n'; else printf 'WAITING  Docker daemon access\n'; failed=1; fi
    elif [[ $role != worker ]]; then
        printf 'MISSING  Docker Engine (service host)\n'; failed=1
    fi
    if command -v incus >/dev/null 2>&1; then printf 'OK       Incus client\n'; else printf 'OPTIONAL Incus client (needed on the fleet controller)\n'; fi
    if ductor_is_container; then
        if ductor_container_health; then printf 'OK       Container SSH broker and lease supervisor\n'; else printf 'WAITING  Container SSH broker or lease supervisor\n'; failed=1; fi
    fi
    if [[ $role == worker ]]; then
        printf 'INFO     Worker role: shared services run on the controller\n'
    elif [[ -f $DUCTOR_STATE_DIR/services/compose.yaml ]]; then
        printf 'OK       Service configuration exists\n'
    else
        printf 'WAITING  Run ductor services prepare\n'
    fi
    printf '\nA successful dependency check does not verify provider sign-in, task handoffs, or live VM execution.\n'
    return "$failed"
}

ductor_setup() {
    local role
    if ! command -v jq >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
        ductor_dependencies --tools-only
    fi
    ductor_require_cmd jq openssl
    if [[ -f $DUCTOR_STATE_DIR/setup.json ]]; then
        role=$(jq -er '.role' "$DUCTOR_STATE_DIR/setup.json")
        ductor_log "Resuming $role setup. Existing secrets will be reused."
    else
        printf '\nDuctor %s — first run\n\n' "$DUCTOR_VERSION"
        printf '%s\n' "Choose this server's role. Other servers can be added later."
        printf '  1) Services: Paperclip, memory, gateway and credentials\n'
        printf '  2) Worker: existing Incus host, no shared service stack\n'
        printf '  3) Combined: services and an existing Incus host\n'
        case $(ductor_prompt 'Role' 3) in
            1) role=control ;;
            2) role=worker ;;
            3) role=combined ;;
            *) ductor_die 'Choose 1, 2 or 3.' ;;
        esac
        jq -n --arg role "$role" --arg created "$(date -u +%FT%TZ)" '{schemaVersion:1,role:$role,createdAt:$created}' >"$DUCTOR_STATE_DIR/setup.json"
    fi
    if [[ $role == control || $role == combined ]]; then
        if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then ductor_dependencies; fi
        ductor_require_cmd docker
        ductor_services_prepare
        if ductor_confirm 'Build/pull and start the Paperclip, MemPalace, ContextForge and OpenBao stack now?'; then
            ductor_services_up
        fi
        ductor_services_urls
        printf '\nNext: initialize and unseal OpenBao with ductor services bao-init and bao-unseal.\n'
        printf 'Sign in to Paperclip and connect your ChatGPT accounts through its Codex connection flow.\n'
    fi
    if [[ $role == worker || $role == combined ]]; then
        printf '\nWorker registration uses your existing Incus configuration.\n'
        printf 'Run ductor nodes probe local to inspect the host, then ductor nodes help to register its budget.\n'
        printf 'Prepare the restricted project and image with your opencode-platform installation first.\n'
    fi
    printf '\nRun ductor to reopen the menu, or ductor doctor to check this host.\n'
}

ductor_menu() {
    local choice
    while true; do
        printf '\nDuctor %s\n' "$DUCTOR_VERSION"
        printf '  1) Setup / resume\n  2) Service status and URLs\n  3) Start services\n  4) Stop services (retain data)\n  5) Server inventory\n  6) Paperclip status\n  7) Diagnostics\n  8) Command help\n  0) Exit\n'
        choice=$(ductor_prompt 'Choose' 0)
        case $choice in
            1) bash "$DUCTOR_SELF" setup || ductor_log 'Setup stopped; state retained.' ;;
            2) bash "$DUCTOR_SELF" status || ductor_log 'Status is incomplete.' ;;
            3) bash "$DUCTOR_SELF" services up || ductor_log 'Start failed; inspect service status.' ;;
            4) if ductor_confirm 'Stop the shared services and retain their data?'; then bash "$DUCTOR_SELF" services down || ductor_log 'Stop failed.'; fi ;;
            5) bash "$DUCTOR_SELF" nodes list || ductor_log 'No inventory available.' ;;
            6) bash "$DUCTOR_SELF" paperclip status || ductor_log 'Paperclip is not connected or unavailable.' ;;
            7) bash "$DUCTOR_SELF" doctor || true ;;
            8) ductor_help ;;
            0) return ;;
            *) ductor_log 'Choose one of the menu entries.' ;;
        esac
    done
}
# Embedded control services. Published addresses default to loopback and can be
# configured per service. TLS normally belongs to the operator's reverse proxy.
# These services are independent upstream applications. Starting them does not
# implicitly grant agents cross-project memory or credential access.

ductor_services_dir() {
    printf '%s/services\n' "$DUCTOR_STATE_DIR"
}

ductor_services_value() {
    local key=$1 file=$2
    awk -v key="$key" 'index($0, key "=") == 1 {sub(/^[^=]*=/, ""); print; exit}' "$file"
}

ductor_services_port() {
    [[ $1 =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535))
}

# Literal addresses only: never interpolate DNS names, shell text or IPv6 zones
# into Compose. Compressed IPv6 is supported without IPv4-mapped notation.
ductor_services_bind_address() {
    local value=$1 part remainder groups=0
    local -a octets=()
    if [[ $value =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        IFS=. read -r -a octets <<<"$value"
        for part in "${octets[@]}"; do
            [[ $part =~ ^(0|[1-9][0-9]{0,2})$ ]] && ((10#$part<=255)) || return 1
        done
        return 0
    fi
    [[ $value == *:* && $value =~ ^[A-Fa-f0-9:]+$ && $value != *:::* ]] || return 1
    [[ $value != :* || $value == ::* ]] && [[ $value != *: || $value == *:: ]] || return 1
    remainder=$value
    if [[ $value == *::* ]]; then
        remainder=${value/::/:}
        [[ $remainder != *::* ]] || return 1
    else
        [[ $value != :* && $value != *: ]] || return 1
    fi
    IFS=: read -r -a octets <<<"$remainder"
    for part in "${octets[@]}"; do
        [[ -n $part ]] || continue
        [[ $part =~ ^[A-Fa-f0-9]{1,4}$ ]] || return 1
        groups=$((groups+1))
    done
    if [[ $value == *::* ]]; then ((groups<8)); else ((groups==8)); fi
}

ductor_services_local_origin() {
    local service=$1 settings=${2:-$DUCTOR_STATE_DIR/services/settings.env} address port
    [[ $service == PAPERCLIP || $service == CONTEXTFORGE || $service == MEMPALACE || $service == OPENBAO ]] || return 1
    port=$(ductor_services_value "${service}_PORT" "$settings") || return 1
    address=$(ductor_services_value "${service}_BIND_ADDRESS" "$settings") || return 1
    address=${address:-127.0.0.1}
    ductor_services_port "$port" && ductor_services_bind_address "$address" || return 1
    case $address in 0.0.0.0) address=127.0.0.1 ;; ::) address=::1 ;; esac
    [[ $address != *:* ]] || address="[$address]"
    printf 'http://%s:%s\n' "$address" "$port"
}

ductor_services_prepare() (
    set -euo pipefail
    umask 077
    ductor_require_cmd openssl
    local dir settings secrets temporary key value port other address
    local paperclip_port=${DUCTOR_PAPERCLIP_PORT:-3100}
    local forge_port=${DUCTOR_CONTEXTFORGE_PORT:-4444}
    local memory_port=${DUCTOR_MEMPALACE_PORT:-8765}
    local bao_port=${DUCTOR_OPENBAO_PORT:-8200}
    local public_url=${DUCTOR_PAPERCLIP_URL:-http://localhost:$paperclip_port}
    local admin_email=${DUCTOR_ADMIN_EMAIL:-admin@ductor.example.com}
    local -a ports=("$paperclip_port" "$forge_port" "$memory_port" "$bao_port")
    for port in "${ports[@]}"; do
        ductor_services_port "$port" || ductor_die "Service ports must be integers from 1024 to 65535."
    done
    for ((port=0; port<${#ports[@]}; port++)); do
        for ((other=port+1; other<${#ports[@]}; other++)); do
            ((10#${ports[port]} != 10#${ports[other]})) || ductor_die "Service ports must be different."
        done
    done
    # Values are deliberately constrained before entering Compose's env parser.
    [[ $public_url =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?$ ]] || ductor_die "Paperclip URL must be an HTTP(S) origin with no path, credentials, or query."
    [[ $admin_email =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z0-9-]+$ ]] || ductor_die "Provide a valid administrator email."
    dir=$(ductor_services_dir) || return
    [[ ! -L $dir ]] || ductor_die "Service state directory must not be a symlink."
    install -d -m 0700 "$dir" || return
    [[ ! -L $dir/paperclip-plugin ]] || ductor_die "Paperclip plugin directory must not be a symlink."
    install -d -m 0755 "$dir/paperclip-plugin" || return
    settings="$dir/settings.env"
    secrets="$dir/secrets.env"
    [[ ! -L $settings && ! -L $secrets ]] || ductor_die "Service configuration must not be symlinks."
    if [[ ! -e $settings ]]; then
        temporary=$(mktemp "$dir/.settings.XXXXXX") || return
        {
            printf 'PAPERCLIP_PORT=%s\nCONTEXTFORGE_PORT=%s\nMEMPALACE_PORT=%s\nOPENBAO_PORT=%s\n' "$paperclip_port" "$forge_port" "$memory_port" "$bao_port" || return
            printf 'PAPERCLIP_PUBLIC_URL=%s\nPLATFORM_ADMIN_EMAIL=%s\n' "${public_url%/}" "$admin_email" || return
            printf 'PAPERCLIP_ALLOWED_HOSTNAMES=localhost,127.0.0.1\nPAPERCLIP_DEPLOYMENT_EXPOSURE=private\n' || return
            printf 'CONTEXTFORGE_PUBLIC_URL=http://localhost:%s\nCONTEXTFORGE_SECURE_COOKIES=false\nOPENBAO_PUBLIC_URL=http://localhost:%s\n' "$forge_port" "$bao_port"
        } > "$temporary" || return
        mv -- "$temporary" "$settings" || return
    fi
    # Backfill old releases without resetting operator-selected network settings.
    for key in PAPERCLIP CONTEXTFORGE MEMPALACE OPENBAO; do
        address=$(ductor_services_value "${key}_BIND_ADDRESS" "$settings") || return
        if [[ -z $address ]]; then
            address=127.0.0.1
            ductor_services_setting_set "${key}_BIND_ADDRESS" "$address" "$settings" || return
        fi
        ductor_services_bind_address "$address" || ductor_die "Invalid $key published bind address. Use an IPv4 or IPv6 literal."
        port=$(ductor_services_value "${key}_PORT" "$settings") || return
        ductor_services_port "$port" || ductor_die "Invalid $key published port."
    done
    value=$(ductor_services_local_origin CONTEXTFORGE "$settings") || return
    ductor_services_setting_set CONTEXTFORGE_LOCAL_URL "$value" "$settings" || return
    if [[ ! -e $secrets ]]; then
        # Losing this file while volumes remain is a restore operation: changing
        # passwords or encryption keys would make existing data inaccessible.
        [[ ! -e $dir/initialized ]] || ductor_die "Secrets are missing from an existing installation. Restore services/secrets.env from backup."
        temporary=$(mktemp "$dir/.secrets.XXXXXX") || return
        for key in PAPERCLIP_DB_PASSWORD CONTEXTFORGE_DB_PASSWORD BETTER_AUTH_SECRET JWT_SECRET_KEY AUTH_ENCRYPTION_SECRET CSRF_SECRET_KEY MEMPALACE_MCP_HTTP_TOKEN; do
            value=$(openssl rand -hex 32) || return
            [[ $value =~ ^[a-f0-9]{64}$ ]] || ductor_die "Random secret generation failed."
            printf '%s=%s\n' "$key" "$value" >> "$temporary" || return
        done
        for key in PLATFORM_ADMIN_PASSWORD DEFAULT_USER_PASSWORD; do
            value=$(openssl rand -hex 32) || return
            [[ $value =~ ^[a-f0-9]{64}$ ]] || ductor_die "Random secret generation failed."
            printf '%s=Ductor-Aa9!%s\n' "$key" "$value" >> "$temporary" || return
        done
        mv -- "$temporary" "$secrets" || return
    fi
    [[ -s $settings && -s $secrets ]] || ductor_die "Service configuration is empty; restore it before continuing."
    chmod 0600 "$settings" "$secrets" || return
    for key in PAPERCLIP_DB_PASSWORD CONTEXTFORGE_DB_PASSWORD BETTER_AUTH_SECRET JWT_SECRET_KEY AUTH_ENCRYPTION_SECRET CSRF_SECRET_KEY MEMPALACE_MCP_HTTP_TOKEN PLATFORM_ADMIN_PASSWORD DEFAULT_USER_PASSWORD; do
        value=$(ductor_services_value "$key" "$secrets") || return
        [[ -n $value ]] || ductor_die "Missing $key in services/secrets.env. Restore the original value."
    done
    temporary=$(mktemp "$dir/.compose.XXXXXX") || return
    cat > "$temporary" <<'YAML' || return
# Generated by Ductor. Edit settings.env for URLs and ports; secrets.env is private.
# Source contracts: paperclip v2026.1012.0, MemPalace v3.11.0,
# ContextForge v1.0.11, OpenBao v2.7.1. See repository documentation.
name: ductor
x-forge-environment: &forge-environment
  DATABASE_URL: postgresql+psycopg://contextforge:${CONTEXTFORGE_DB_PASSWORD:?missing secret}@contextforge-db:5432/contextforge
  JWT_SECRET_KEY: ${JWT_SECRET_KEY:?missing secret}
  AUTH_ENCRYPTION_SECRET: ${AUTH_ENCRYPTION_SECRET:?missing secret}
  CSRF_SECRET_KEY: ${CSRF_SECRET_KEY:?missing secret}
  PLATFORM_ADMIN_EMAIL: ${PLATFORM_ADMIN_EMAIL:?missing admin email}
  PLATFORM_ADMIN_PASSWORD: ${PLATFORM_ADMIN_PASSWORD:?missing secret}
  DEFAULT_USER_PASSWORD: ${DEFAULT_USER_PASSWORD:?missing secret}
  AUTH_REQUIRED: "true"
  EMAIL_AUTH_ENABLED: "true"
  MCP_CLIENT_AUTH_ENABLED: "true"
  MCP_REQUIRE_AUTH: "true"
  TRUST_PROXY_AUTH: "false"
  API_ALLOW_BASIC_AUTH: "false"
  SSRF_PROTECTION_ENABLED: "true"
  SSRF_ALLOW_LOCALHOST: "false"
  SSRF_ALLOW_PRIVATE_NETWORKS: "false"
  SSRF_ALLOWED_NETWORKS: ${MEMPALACE_NETWORK_CIDRS:-[]}
  ENVIRONMENT: production
  SECURE_COOKIES: ${CONTEXTFORGE_SECURE_COOKIES:-false}
  CSRF_COOKIE_SECURE: ${CONTEXTFORGE_SECURE_COOKIES:-false}
  CSRF_TRUSTED_ORIGINS: '["${CONTEXTFORGE_PUBLIC_URL:-http://localhost:4444}","http://localhost:${CONTEXTFORGE_PORT}","http://127.0.0.1:${CONTEXTFORGE_PORT}","${CONTEXTFORGE_LOCAL_URL:-http://127.0.0.1:4444}"]'
  ALLOWED_ORIGINS: '["${CONTEXTFORGE_PUBLIC_URL:-http://localhost:4444}","http://localhost:${CONTEXTFORGE_PORT}","http://127.0.0.1:${CONTEXTFORGE_PORT}","${CONTEXTFORGE_LOCAL_URL:-http://127.0.0.1:4444}"]'
  APP_DOMAIN: ${CONTEXTFORGE_PUBLIC_URL:-http://localhost:4444}
services:
  caddy:
    profiles: [team-access]
    image: caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
