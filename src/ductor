      - openbao:/openbao/file
      - ./openbao.hcl:/openbao/config/ductor.hcl:ro
    healthcheck:
      # Exit 2 means sealed; the service is alive but cannot release credentials.
      test: [CMD-SHELL, "bao status >/dev/null 2>&1; code=$$?; [ $$code -eq 0 ] || [ $$code -eq 2 ]"]
      interval: 15s
