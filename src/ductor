    set -euo pipefail
    set +x
    umask 077
    local action=${1:-open} settings company prefix work
    [[ $# -le 1 ]] || ductor_die 'Usage: ductor paperclip conversation [enable|status|open]'
    case $action in enable|status|open) ;; *) ductor_die 'Usage: ductor paperclip conversation [enable|status|open]' ;; esac
