        acquire) ductor_broker_acquire "$request" "$work" ;;
        resume)
            id=$(jq -er .params.providerLeaseId "$request"); lease=$(ductor_broker_lease_path "$id")
            ductor_broker_existing "$request" "$lease" resume >/dev/null || return
            jq --slurpfile l "$lease" '.params.agentId=$l[0].agentId | .params.config.profile=$l[0].profile | .params.runId=$l[0].runId' "$request" > "$work/resume.json" || return
            ductor_broker_acquire "$work/resume.json" "$work"
            ;;
        execute|realize|release|destroy)
            if [[ $operation == execute || $operation == realize ]]; then
                id=$(jq -er .params.lease.providerLeaseId "$request") || return
            else
                id=$(jq -er .params.providerLeaseId "$request") || return
            fi
            lease=$(ductor_broker_lease_path "$id")
            [[ -f $lease && ! -L $lease ]] || ductor_die 'Lease not found.'
            location=$(ductor_broker_existing "$request" "$lease" "$operation") || return
            case $operation in
                execute) ductor_broker_execute "$request" "$lease" "$work" ;;
                realize)
                    profile=$(ductor_profile_file "$(jq -r .profile "$lease")")
                    jq '{cwd:.runtime.workspace,metadata:{managedBy:"ductor"}}' "$profile"
                    ;;
                release|destroy) ductor_broker_stop "$lease" ;;
            esac
            ;;
        spawn) ductor_broker_spawn "$request" "$work" ;;
    esac
)
# Execute one authenticated-controller request inside an already isolated guest.
# The caller selects the bound non-root Incus UID/GID; this function never sudoes.
ductor_guest_execute() (
    set +x
    umask 077
    local request=${1:-} descriptor file_path parent permissions owner links command cwd duration timeout_ms
    local work='' monitor_pid='' stdout_pid='' stderr_pid='' stdout_anchor='' stderr_anchor=''
    local status=125 timed_out=false timeout_signal='' stdout_size stderr_size key capture_failed=false tick
    local -a arguments=()
    guest_error() {
        /usr/bin/jq -n --arg message "$1" '{stdout:"",stderr:"",exitCode:125,signal:null,timedOut:false,error:$message}'
        return 1
    }
    guest_stop_group() {
        if [[ -n $monitor_pid ]]; then
            # GNU timeout creates a process group. Stop remaining descendants
            # even when the immediate command exited before its children.
            if kill -0 -- "-$monitor_pid" 2>/dev/null; then
                kill -TERM -- "-$monitor_pid" 2>/dev/null || true
                /usr/bin/sleep 0.2
                kill -KILL -- "-$monitor_pid" 2>/dev/null || true
            elif kill -0 "$monitor_pid" 2>/dev/null; then
                kill -TERM "$monitor_pid" 2>/dev/null || true
            fi
            wait "$monitor_pid" 2>/dev/null || true
            monitor_pid=''
        fi
    }
    guest_cleanup() {
        guest_stop_group
        [[ -z $stdout_anchor ]] || exec {stdout_anchor}>&-
        [[ -z $stderr_anchor ]] || exec {stderr_anchor}>&-
        [[ -z $stdout_pid ]] || { kill "$stdout_pid" 2>/dev/null || true; wait "$stdout_pid" 2>/dev/null || true; }
        [[ -z $stderr_pid ]] || { kill "$stderr_pid" 2>/dev/null || true; wait "$stderr_pid" 2>/dev/null || true; }
        [[ -z $work ]] || /usr/bin/rm -rf -- "$work"
    }
    trap guest_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    for key in /usr/bin/jq /usr/bin/timeout /usr/bin/stat /usr/bin/iconv /usr/bin/mktemp /usr/bin/mkfifo /usr/bin/head /usr/bin/env /bin/bash; do
        if [[ ! -x $key ]]; then
            printf '%s\n' '{"stdout":"","stderr":"","exitCode":125,"signal":null,"timedOut":false,"error":"Required guest execution utility is missing"}'
            return 1
        fi
    done
    [[ $# == 1 && $EUID != 0 ]] || { guest_error 'Execution requires exactly one request and a bound non-root UID'; return 1; }
    [[ $request == /* && -f $request && ! -L $request ]] || { guest_error 'Request must be an absolute regular file without symlinks'; return 1; }
    [[ $request != *'/../'* && $request != *'/./'* && $request != *'//'* ]] || { guest_error 'Request path must be canonical'; return 1; }
    # Check all ancestors, including /run, rather than only the immediate parent.
    # Root provisions this tree; agent-writable workspace/request directories are
    # unsuitable because another request could be substituted between calls.
    parent=${request%/*}
    [[ -n $parent ]] || parent=/
    while :; do
        [[ -d $parent && ! -L $parent ]] || { guest_error 'Request directory must be root-provisioned without symlinks'; return 1; }
        owner=$(/usr/bin/stat -c '%u' -- "$parent") || return 1
        permissions=$(/usr/bin/stat -c '%a' -- "$parent") || return 1
        [[ $owner == 0 ]] && (( (8#$permissions & 8#022) == 0 )) || { guest_error 'Request directory must be root-owned and not group/world writable'; return 1; }
        [[ $parent != / ]] || break
        parent=${parent%/*}; [[ -n $parent ]] || parent=/
    done
    owner=$(/usr/bin/stat -c '%u' -- "$request") || return 1
    permissions=$(/usr/bin/stat -c '%a' -- "$request") || return 1
    links=$(/usr/bin/stat -c '%h' -- "$request") || return 1
    [[ $owner == "$EUID" && $permissions == 600 && $links == 1 ]] || { guest_error 'Request must be owned by the execution UID, mode 0600, with one link'; return 1; }
    # Read through one open descriptor, retaining the verified inode for parsing.
    exec {descriptor}< "$request" || { guest_error 'Request cannot be opened'; return 1; }
    file_path=/proc/self/fd/$descriptor
    [[ $(/usr/bin/stat -Lc '%u:%a:%h' "$file_path") == "$EUID:600:1" ]] || { guest_error 'Request ownership changed while opening'; return 1; }
    /usr/bin/iconv -f UTF-8 -t UTF-8 "$file_path" >/dev/null 2>&1 || { guest_error 'Request JSON must be valid UTF-8'; return 1; }
    /usr/bin/jq -e '
      type == "object" and
      ((keys - ["command","args","cwd","env","stdin","timeoutMs"]) | length == 0) and
      (.command | type == "string" and length > 0 and (index("\u0000")==null)) and
      (.cwd | type == "string" and startswith("/") and (index("\u0000")==null)) and
      ((.args // []) | type == "array" and all(type == "string" and (index("\u0000")==null))) and
      ((.env // {}) | type == "object" and (to_entries | all((.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) and (.value | type == "string" and (index("\u0000")==null))))) and
      ((.stdin // "") | type == "string") and
      (.timeoutMs | type == "number" and floor == . and . >= 1 and . <= 86400000)
    ' "$file_path" >/dev/null 2>&1 || { guest_error 'Invalid execution request schema'; return 1; }
    IFS= read -r -d '' command < <(/usr/bin/jq -j '.command, "\u0000"' "$file_path") || return 1
    IFS= read -r -d '' cwd < <(/usr/bin/jq -j '.cwd, "\u0000"' "$file_path") || return 1
    [[ -d $cwd && -x $cwd ]] || { guest_error 'Working directory does not exist or is inaccessible'; return 1; }
    timeout_ms=$(/usr/bin/jq -r '.timeoutMs' "$file_path") || return 1
    printf -v duration '%d.%03ds' "$((timeout_ms / 1000))" "$((timeout_ms % 1000))"
    mapfile -d '' -t arguments < <(/usr/bin/jq -j '(.args // [])[] | ., "\u0000"' "$file_path")
    work=$(/usr/bin/mktemp -d /tmp/ductor-execute.XXXXXXXX) || { guest_error 'Cannot create private execution capture'; return 1; }
    /usr/bin/jq -j '.stdin // ""' "$file_path" > "$work/stdin" || return 1
    /usr/bin/jq -j '(.env // {}) | to_entries[] | (.key + "=" + .value), "\u0000"' "$file_path" > "$work/environment" || return 1
    exec {descriptor}<&-
    : > "$work/stdout"; : > "$work/stderr"
    /usr/bin/mkfifo "$work/stdout.pipe" "$work/stderr.pipe" || return 1
    # Bounded readers cap capture only. RLIMIT_FSIZE would also cap repository
    # files, compiled binaries, and archives created by the actual agent task.
    exec {stdout_anchor}<> "$work/stdout.pipe"
    exec {stderr_anchor}<> "$work/stderr.pipe"
    /usr/bin/head -c 33554433 < "$work/stdout.pipe" > "$work/stdout" {stdout_anchor}>&- {stderr_anchor}>&- &
    stdout_pid=$!
    /usr/bin/head -c 33554433 < "$work/stderr.pipe" > "$work/stderr" {stdout_anchor}>&- {stderr_anchor}>&- &
    stderr_pid=$!
    # The child gets the requested environment, never the supervising shell.
    # Its stderr is redirected inside the wrapper, so timeout's own diagnostics
    # remain separate and a command exiting 124 is not mistaken for a timeout.
    /usr/bin/env -u BASH_ENV -u ENV -u SHELLOPTS -u BASHOPTS -u POSIXLY_CORRECT LC_ALL=C \
        /usr/bin/timeout --preserve-status --verbose --signal=TERM --kill-after=2s "$duration" \
        /bin/bash --noprofile --norc -c '
            output=$1; errors=$2; input=$3; directory=$4; environment_file=$5; started=$6
            shift 6
            exec > "$output" 2> "$errors" < "$input"
            printf ready > "$started" || exit 125
            cd -- "$directory" || exit 125
            while IFS= read -r -d "" assignment; do
                export "$assignment" || exit 125
            done < "$environment_file"
            exec -- "$@"
        ' ductor-guest "$work/stdout.pipe" "$work/stderr.pipe" "$work/stdin" "$cwd" "$work/environment" "$work/started" \
        "$command" "${arguments[@]}" 2> "$work/monitor" {stdout_anchor}>&- {stderr_anchor}>&- &
    monitor_pid=$!
    for ((tick=0; tick<50; tick++)); do
        [[ ! -f $work/started ]] && kill -0 "$monitor_pid" 2>/dev/null || break
        /usr/bin/sleep 0.1
    done
    # Once the child opened both FIFOs, remove our temporary anchors. Keeping
    # their read ends open would suppress SIGPIPE when a capture limit is hit.
    exec {stdout_anchor}>&-; stdout_anchor=''
    exec {stderr_anchor}>&-; stderr_anchor=''
    if wait "$monitor_pid" 2>/dev/null; then status=0; else status=$?; fi
    if /usr/bin/grep -Fq 'timeout: sending signal TERM' "$work/monitor"; then
        timed_out=true; timeout_signal=SIGTERM
    fi
    if /usr/bin/grep -Fq 'timeout: sending signal KILL' "$work/monitor"; then
        timed_out=true; timeout_signal=SIGKILL
    fi
    guest_stop_group
    # Ordinary descendants were stopped with the command group. A detached
    # writer must not keep our output pipes open forever after the run ends.
    for ((tick=0; tick<50; tick++)); do
        if ! kill -0 "$stdout_pid" 2>/dev/null && ! kill -0 "$stderr_pid" 2>/dev/null; then break; fi
        /usr/bin/sleep 0.1
    done
    if kill -0 "$stdout_pid" 2>/dev/null || kill -0 "$stderr_pid" 2>/dev/null; then
        guest_error 'Output streams did not close after command completion'
        return 1
    fi
    wait "$stdout_pid" 2>/dev/null || capture_failed=true
    wait "$stderr_pid" 2>/dev/null || capture_failed=true
    stdout_pid=''; stderr_pid=''
    [[ $capture_failed == false ]] || { guest_error 'Command output capture failed'; return 1; }
    stdout_size=$(/usr/bin/stat -c '%s' "$work/stdout") || return 1
    stderr_size=$(/usr/bin/stat -c '%s' "$work/stderr") || return 1
    if (( stdout_size + stderr_size > 33554432 )); then
        /usr/bin/jq -n --argjson observed "$status" --argjson timedOut "$timed_out" \
            '{stdout:"",stderr:"",exitCode:125,signal:null,timedOut:$timedOut,error:"Combined output exceeds 32 MiB; output was not returned",observedExitStatus:$observed}'
        return 1
    fi
    if ! /usr/bin/iconv -f UTF-8 -t UTF-8 "$work/stdout" >/dev/null 2>&1 || ! /usr/bin/iconv -f UTF-8 -t UTF-8 "$work/stderr" >/dev/null 2>&1; then
        guest_error 'Command output is not valid UTF-8; binary results must be encoded by the caller'
        return 1
    fi
    # Bash exposes only a numeric shell wait status, which cannot distinguish
    # exit(143) from SIGTERM. Do not invent a native signal from status >128.
    /usr/bin/jq -n --rawfile stdout "$work/stdout" --rawfile stderr "$work/stderr" \
        --argjson status "$status" --argjson timedOut "$timed_out" --arg timeoutSignal "$timeout_signal" \
        '{stdout:$stdout,stderr:$stderr,exitCode:$status,signal:null,timedOut:$timedOut,statusEncoding:"shell",timeoutSignal:(if $timeoutSignal == "" then null else $timeoutSignal end)}'
)

# Container controller: one SSH broker and one lease supervisor. The container
# uses the host Docker API and never starts a nested Docker daemon or systemd.
ductor_broker_host_key_files() {
    local key
    if ductor_is_container; then
        key=$DUCTOR_STATE_DIR/container/ssh_host_ed25519_key.pub
        [[ ! -f $key || -L $key ]] || printf '%s\n' "$key"
    else
        for key in /etc/ssh/ssh_host_*_key.pub; do
            [[ ! -f $key || -L $key ]] || printf '%s\n' "$key"
        done
    fi
}

ductor_container_settings() {
    ductor_is_container || ductor_die 'This command is provided by the Ductor container image. Native installations use the host SSH service and systemd lease timer.'
    [[ $EUID == 0 ]] || ductor_die 'The container controller must run as root.'
    [[ $DUCTOR_STATE_DIR == /var/lib/ductor && $DUCTOR_INSTALL_DIR == /usr/local/bin ]] || ductor_die 'The container controller requires /var/lib/ductor mounted at the same absolute path on the Docker host.'
    [[ $INCUS_CONF == "$DUCTOR_STATE_DIR/incus" ]] || ductor_die 'The container Incus client identity must remain at /var/lib/ductor/incus so operator and forced broker commands use the same credentials.'
    DUCTOR_BROKER_LISTEN_ADDRESS=${DUCTOR_BROKER_LISTEN_ADDRESS:-0.0.0.0}
    DUCTOR_BROKER_PORT=${DUCTOR_BROKER_PORT:-2222}
    DUCTOR_REAPER_INTERVAL=${DUCTOR_REAPER_INTERVAL:-30}
    [[ $DUCTOR_BROKER_LISTEN_ADDRESS =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || $DUCTOR_BROKER_LISTEN_ADDRESS =~ ^[0-9a-fA-F:]*:[0-9a-fA-F:]+$ ]] || ductor_die 'DUCTOR_BROKER_LISTEN_ADDRESS must be a literal IPv4 or IPv6 address.'
    [[ $DUCTOR_BROKER_PORT =~ ^[1-9][0-9]{0,4}$ ]] && (( DUCTOR_BROKER_PORT <= 65535 )) || ductor_die 'DUCTOR_BROKER_PORT must be between 1 and 65535.'
    [[ $DUCTOR_REAPER_INTERVAL =~ ^[1-9][0-9]{0,3}$ ]] && (( DUCTOR_REAPER_INTERVAL <= 3600 )) || ductor_die 'DUCTOR_REAPER_INTERVAL must be between 1 and 3600 seconds.'
}

ductor_container_authorized_key() {
    local key=$1 destination=/run/ductor-sshd/authorized_keys temporary
    [[ -d /run/ductor-sshd && ! -L /run/ductor-sshd && ! -L $destination ]] || ductor_die 'The container SSH runtime directory is unavailable or unsafe.'
    temporary=$(mktemp /run/ductor-sshd/.authorized_keys.XXXXXX) || return
    if [[ -f $key ]]; then
        [[ ! -L $key ]] || { rm -f "$temporary"; ductor_die 'The broker public key must not be a symlink.'; }
        printf 'restrict,command="/usr/bin/sudo -n /usr/local/bin/ductor broker" %s\n' "$(cat "$key")" >"$temporary" || return
    fi
    chmod 0644 "$temporary" || return
    mv -f "$temporary" "$destination"
}

ductor_container_docker_endpoint() {
    local endpoint context
    ductor_require_cmd docker
    if [[ -n ${DOCKER_CONTEXT:-} ]]; then
        endpoint=$(docker context inspect "$DOCKER_CONTEXT" --format '{{.Endpoints.docker.Host}}') || return
    elif [[ -n ${DOCKER_HOST:-} ]]; then
        endpoint=$DOCKER_HOST
    else
        context=$(docker context show) || return
        endpoint=$(docker context inspect "$context" --format '{{.Endpoints.docker.Host}}') || return
    fi
    [[ $endpoint == unix:///var/run/docker.sock ]] || ductor_die 'The controller image requires the local Docker socket at /var/run/docker.sock. Remote Docker contexts cannot preserve its sibling-service bind paths.'
    [[ -S /var/run/docker.sock ]] || ductor_die 'Bind the host Docker socket to /var/run/docker.sock before starting the controller.'
}

ductor_container_broker_install() {
    local key=$1 directory=$DUCTOR_STATE_DIR/container temporary
    ductor_container_settings
    [[ -f /run/ductor-sshd/sshd_config && ! -L /run/ductor-sshd/sshd_config ]] || ductor_die 'Start the Ductor container with its default serve command before configuring its broker.'
    ductor_private_dir "$directory"
    [[ ! -L $directory/broker_ed25519.pub ]] || ductor_die 'Refusing a symlinked broker public key.'
    temporary=$(mktemp "$directory/.broker-key.XXXXXX") || return
    cat "$key" >"$temporary" || return
    chmod 0600 "$temporary" || return
    mv -f "$temporary" "$directory/broker_ed25519.pub" || return
    ductor_container_authorized_key "$directory/broker_ed25519.pub" || return
    ductor_log 'OpenBao-managed broker public key installed in the container SSH service. The private key remains in the OpenBao credential flow.'
}

ductor_container_prepare() {
    local directory=$DUCTOR_STATE_DIR/container runtime=/run/ductor-sshd temporary key
    ductor_container_settings
    ductor_require_cmd ssh-keygen ssh-keyscan sshd sudo visudo jq incus
    ductor_container_docker_endpoint || return
    id ductor-broker >/dev/null 2>&1 || ductor_die 'The image is missing its dedicated ductor-broker account.'
    ductor_private_dir "$directory"
    ductor_private_dir "$INCUS_CONF"
    [[ ! -L $runtime && ! -L /run/sshd && ! -L /var/lib/ductor-broker ]] || ductor_die 'Refusing symlinked container SSH directories.'
    install -d -o root -g root -m 0755 "$runtime" /run/sshd /var/lib/ductor-broker || return
    key=$directory/ssh_host_ed25519_key
    [[ ! -L $key && ! -L $key.pub ]] || ductor_die 'Refusing symlinked SSH host keys.'
    if [[ ! -f $key ]]; then
        temporary=$(mktemp -d "$directory/.host-key.XXXXXX") || return
        ssh-keygen -q -t ed25519 -N '' -C ductor-controller -f "$temporary/key" || { rm -rf "$temporary"; return 1; }
        mv "$temporary/key" "$key" || return
        mv "$temporary/key.pub" "$key.pub" || return
        rmdir "$temporary" || return
    fi
    # Rebuild the public half from the private key, including after an interrupted
    # first start. Never replace a persisted private key during image updates.
    temporary=$(mktemp "$directory/.host-public.XXXXXX") || return
    ssh-keygen -y -P '' -f "$key" >"$temporary" || { rm -f "$temporary"; return 1; }
    chmod 0600 "$key" "$temporary" || return
    mv -f "$temporary" "$key.pub" || return
    ductor_container_authorized_key "$directory/broker_ed25519.pub" || return
    [[ ! -L /etc/sudoers.d/ductor-broker ]] || ductor_die 'Refusing a symlinked broker sudo policy.'
    temporary=$(mktemp) || return
    printf 'ductor-broker ALL=(root) NOPASSWD: /usr/local/bin/ductor broker\n' >"$temporary" || return
    visudo -cf "$temporary" >/dev/null || { rm -f "$temporary"; ductor_die 'Invalid container broker sudo policy.'; }
    install -o root -g root -m 0440 "$temporary" /etc/sudoers.d/ductor-broker || return
    rm -f "$temporary"
    [[ ! -L $runtime/sshd_config ]] || ductor_die 'Refusing a symlinked SSH server configuration.'
    temporary=$(mktemp "$runtime/.sshd-config.XXXXXX") || return
    cat >"$temporary" <<CONFIG
Port $DUCTOR_BROKER_PORT
ListenAddress $DUCTOR_BROKER_LISTEN_ADDRESS
HostKey $key
PidFile $runtime/sshd.pid
AuthorizedKeysFile $runtime/authorized_keys
AllowUsers ductor-broker
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
UsePAM no
StrictModes yes
DisableForwarding yes
PermitTTY no
PermitUserEnvironment no
PermitUserRC no
ForceCommand /usr/bin/sudo -n /usr/local/bin/ductor broker
MaxAuthTries 3
LoginGraceTime 30
LogLevel VERBOSE
CONFIG
    chmod 0600 "$temporary" || return
    /usr/sbin/sshd -t -f "$temporary" || { rm -f "$temporary"; return 1; }
    mv -f "$temporary" "$runtime/sshd_config"
}

ductor_container_reaper_loop() {
    local child='' pause=''
    trap 'trap - TERM INT; [[ -z $child ]] || kill "$child" 2>/dev/null || true; [[ -z $pause ]] || kill "$pause" 2>/dev/null || true; wait 2>/dev/null || true; exit 0' TERM INT
    while :; do
        /usr/local/bin/ductor broker reap & child=$!
        if ! wait "$child"; then ductor_log 'Lease reconciliation will retry; a mutation may currently hold the controller lock.'; fi
        child=''
        sleep "$DUCTOR_REAPER_INTERVAL" & pause=$!
        wait "$pause"
        pause=''
    done
}

ductor_container_health() {
    local runtime=/run/ductor-sshd pid probe expected observed port address
    ductor_is_container || return 1
    [[ -s $runtime/sshd.pid && -s $runtime/reaper.pid && -s $runtime/endpoint.json && -s $DUCTOR_STATE_DIR/container/ssh_host_ed25519_key.pub ]] || return 1
    for pid in "$runtime/sshd.pid" "$runtime/reaper.pid"; do
        read -r probe <"$pid" || return 1
        [[ $probe =~ ^[1-9][0-9]*$ ]] && kill -0 "$probe" 2>/dev/null || return 1
    done
    port=$(jq -er .port "$runtime/endpoint.json") || return 1
    address=$(jq -er .address "$runtime/endpoint.json") || return 1
    case $address in 0.0.0.0) address=127.0.0.1 ;; ::) address=::1 ;; esac
    expected=$(awk '{print $1 " " $2}' "$DUCTOR_STATE_DIR/container/ssh_host_ed25519_key.pub") || return 1
    observed=$(ssh-keyscan -T 2 -p "$port" -t ed25519 "$address" 2>/dev/null | awk '$2=="ssh-ed25519" {print $2 " " $3}') || return 1
    [[ $observed == "$expected" ]]
}

ductor_container_status() {
    local healthy=false fingerprint='' key=$DUCTOR_STATE_DIR/container/ssh_host_ed25519_key.pub
    ductor_is_container || ductor_die 'Container status is only available in the Ductor image.'
    if ductor_container_health; then healthy=true; fi
    if [[ -s $key ]]; then fingerprint=$(ssh-keygen -lf "$key") || return; fi
    [[ -s /run/ductor-sshd/endpoint.json ]] || ductor_die 'The container supervisor has not started.'
    jq --argjson healthy "$healthy" --arg fingerprint "$fingerprint" --arg key "$key" '. + {healthy:$healthy,hostKeyFingerprint:$fingerprint,hostKeyFile:$key}' /run/ductor-sshd/endpoint.json
}

ductor_container_supervisor_lock() {
    local directory=$DUCTOR_STATE_DIR/container
    # This lock is independent of the mutation lock and remains held for the
    # lifetime of the daemon. It belongs to persistent state, so two containers
    # cannot supervise one inventory even with different SSH ports.
    ductor_private_dir "$directory"
    [[ ! -L $directory/supervisor.lock ]] || ductor_die 'Refusing a symlinked supervisor lock.'
    exec 8>"$directory/supervisor.lock"
    flock -n 8 || ductor_die 'A container supervisor is already running for this state directory.'
}

ductor_container_serve() {
    local ssh_pid='' reaper_pid='' status=1 runtime=/run/ductor-sshd
    ductor_container_settings
    ductor_container_supervisor_lock
    [[ ! -L $runtime ]] || ductor_die 'Refusing a symlinked container SSH directory.'
    install -d -o root -g root -m 0755 "$runtime" || exit 1
    ductor_lock
    ductor_container_prepare || exit 1
    ductor_unlocked
    trap 'trap - TERM INT EXIT; [[ -z $reaper_pid ]] || kill "$reaper_pid" 2>/dev/null || true; [[ -z $ssh_pid ]] || kill "$ssh_pid" 2>/dev/null || true; wait 2>/dev/null || true; rm -f "$runtime/sshd.pid" "$runtime/reaper.pid"; exit "$status"' EXIT
    trap 'status=0; exit 0' TERM INT
    jq -n --arg address "$DUCTOR_BROKER_LISTEN_ADDRESS" --argjson port "$DUCTOR_BROKER_PORT" '{address:$address,port:$port,user:"ductor-broker"}' >"$runtime/endpoint.json" || exit 1
    /usr/sbin/sshd -D -e -f "$runtime/sshd_config" 8>&- & ssh_pid=$!
    printf '%s\n' "$ssh_pid" >"$runtime/sshd.pid"
    ductor_container_reaper_loop 8>&- & reaper_pid=$!
    printf '%s\n' "$reaper_pid" >"$runtime/reaper.pid"
    ductor_log "Container controller listening on $DUCTOR_BROKER_LISTEN_ADDRESS:$DUCTOR_BROKER_PORT. Configure it using docker compose exec ductor ductor setup."
    ssh-keygen -lf "$DUCTOR_STATE_DIR/container/ssh_host_ed25519_key.pub" >&2 || exit 1
    if wait -n "$ssh_pid" "$reaper_pid"; then status=1; else status=$?; fi
    ductor_log 'A container supervisor process stopped. Exiting so Docker can restart the controller.'
    exit "$status"
}
# Interactive configuration is only a front end to the same CLI commands. Every
# mutation runs in a new Bash process so menu conditionals cannot disable errexit
# inside deployment code. This fragment is embedded in the single distributable.
ductor_ui_has_dialog() {
    command -v whiptail >/dev/null 2>&1 && [[ ${TERM:-dumb} != dumb && ( -t 1 || -t 2 ) ]]
}

ductor_ui_message() {
    local title=$1 message=$2
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --scrolltext --msgbox "$message" 22 78 </dev/tty >/dev/tty
    else
        printf '\n%s\n%s\n' "$title" "$message" >&2
    fi
}

ductor_ui_input() {
    local title=$1 prompt=$2 default=${3:-} answer
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --inputbox "$prompt" 12 78 "$default" 3>&1 1>/dev/tty 2>&3 </dev/tty
    else
        [[ -r /dev/tty ]] || return 1
        printf '%s%s: ' "$prompt" "${default:+ [$default]}" >/dev/tty
        IFS= read -r answer </dev/tty || return 1
        printf '%s\n' "${answer:-$default}"
    fi
}

ductor_ui_confirm() {
    local title=$1 prompt=$2 answer
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --defaultno --yesno "$prompt" 14 78 </dev/tty >/dev/tty
    else
        [[ -r /dev/tty ]] || return 1
        printf '%s [y/N]: ' "$prompt" >/dev/tty
        IFS= read -r answer </dev/tty || return 1
        [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]]
    fi
}

ductor_ui_secret() {
    local title=$1 prompt=$2 answer
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --passwordbox "$prompt" 12 78 3>&1 1>/dev/tty 2>&3 </dev/tty
    else
        [[ -r /dev/tty ]] || return 1
        printf '%s: ' "$prompt" >/dev/tty
        IFS= read -r -s answer </dev/tty || return 1
        printf '\n' >/dev/tty
        printf '%s' "$answer"
    fi
}

ductor_ui_menu() {
    local title=$1 prompt=$2 answer tag label
    shift 2
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --menu "$prompt" 24 80 15 "$@" 3>&1 1>/dev/tty 2>&3 </dev/tty
    else
        [[ -r /dev/tty ]] || return 1
        printf '\n%s\n%s\n' "$title" "$prompt" >/dev/tty
        while (($#)); do tag=$1; label=$2; shift 2; printf '  %-12s %s\n' "$tag" "$label" >/dev/tty; done
        printf 'Choice (blank cancels): ' >/dev/tty
        IFS= read -r answer </dev/tty || return 1
        [[ -n $answer ]] || return 1
        printf '%s\n' "$answer"
    fi
}

ductor_console_exec() {
    [[ -n ${DUCTOR_SELF:-} && -f $DUCTOR_SELF ]] || ductor_die 'Install Ductor before using its management console.'
    DUCTOR_STATE_DIR="$DUCTOR_STATE_DIR" DUCTOR_INSTALL_DIR="${DUCTOR_INSTALL_DIR:-/usr/local/bin}" \
        bash "$DUCTOR_SELF" "$@" 9>&-
}

ductor_console_tools_ready() {
    local dependency
    for dependency in jq curl openssl ssh git flock stat; do
        command -v "$dependency" >/dev/null 2>&1 || return 1
    done
}

ductor_console_control_ready() {
    command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 &&
        command -v sudo >/dev/null 2>&1 && { command -v sshd >/dev/null 2>&1 || [[ -x /usr/sbin/sshd ]]; }
}

ductor_console_dependencies() {
    local scope=${1:-tools}
    case $scope in
        tools)
            if ! ductor_console_tools_ready; then
                ductor_log 'Installing the missing setup utilities before reading JSON configuration.'
                ductor_console_exec dependencies --tools-only || return 1
                ductor_console_tools_ready || { ductor_log 'Setup utilities remain unavailable. Complete ductor dependencies --tools-only, then rerun setup.'; return 1; }
            fi
            ;;
        control|combined)
            if ! ductor_console_control_ready; then
                ductor_log 'The selected service-host role requires Docker Compose v2 and its SSH broker utilities.'
                ductor_console_exec dependencies || return 1
                ductor_console_control_ready || { ductor_log 'Service-host dependencies remain unavailable. Complete ductor dependencies, then retry apply.'; return 1; }
            fi
            ;;
        worker) return 0 ;;
        *) ductor_die 'Invalid dependency scope.' ;;
    esac
}

ductor_console_run() (
    umask 077
    local title=$1 work status=0; shift
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-console.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    printf '\n%s…\n' "$title" >&2
    if ductor_console_exec "$@" >"$work/output" 2>&1; then
        printf '\nCommand completed successfully.\n' >>"$work/output"
    else
        status=$?
        printf '\nCommand stopped with exit %s. Saved state was retained; inspect the output before retrying.\n' "$status" >>"$work/output"
    fi
    if ductor_ui_has_dialog; then
        whiptail --title "$title" --scrolltext --textbox "$work/output" 24 80 </dev/tty >/dev/tty || true
    else
        cat "$work/output"
    fi
    return "$status"
)

ductor_config_validate() {
    local file=$1 url address
    [[ -f $file && ! -L $file ]] || ductor_die 'Configuration must be a regular file.'
    jq -e '
      def ident: type=="string" and test("^[A-Za-z][A-Za-z0-9_-]{0,62}$");
      def profile: type=="string" and test("^[a-z][a-z0-9-]{0,47}$");
      def agentname: type=="string" and length>0 and length<=100 and (test("[[:cntrl:]]")|not);
      def positive: type=="number" and floor==. and .>0 and .<=999999999;
      .schemaVersion==1 and (.role=="control" or .role=="worker" or .role=="combined") and
      (.services | type=="object") and (.services.paperclipUrl | type=="string") and
      (.services.gatewayOrigin | type=="string") and (.services.openbaoUrl | type=="string") and
      ((.services|has("mempalaceUrl")|not) or (.services.mempalaceUrl|type=="string")) and
      ((.services|has("publish")|not) or (.services.publish|type=="object")) and
      (.nodes | type=="array") and (.profiles | type=="array") and
      ((has("credentials")|not) or (.credentials.openbaoAdminTokenFile | type=="string" and (.=="" or startswith("/")))) and
      ((has("identity")|not) or (.identity.emailDomain | type=="string" and (.=="" or test("^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$")))) and
      ((has("access")|not) or (.access==null) or (.access |
        (.managedTls|type=="boolean") and (.email|type=="string") and
        ((has("trustProxy")|not) or (.trustProxy|type=="boolean")) and
        (.managedTls==false or (.email|test("^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\\.[A-Za-z0-9-]+$"))))) and
      ((has("broker")|not) or (.broker |
        (.host|type=="string" and (.=="" or test("^[A-Za-z0-9][A-Za-z0-9.-]*$"))) and
        (.user|type=="string" and test("^[a-z_][a-z0-9_-]{0,31}$")) and
        (.port|type=="number" and floor==. and .>=1 and .<=65535) and
        (.knownHostsFile|type=="string" and (.=="" or startswith("/"))))) and
      ((has("agents")|not) or (.agents | type=="array" and
        all((.name|agentname) and (.profile|profile) and ((has("parentName")|not) or (.parentName|agentname))) and
        (map(.name)|length==(unique|length)) and
        (reduce .[] as $agent ({seen:[],valid:true};
          .valid=(.valid and (($agent|has("parentName")|not) or (.seen|index($agent.parentName)!=null))) |
          .seen+=[$agent.name]) | .valid))) and
      (.nodes | all(
        (.id|ident) and (.remote|ident) and (.project|ident) and .project!="default" and
        (.pool|ident) and (.profiles | type=="array" and length>0 and all(ident) and length==(unique|length)) and
        (.cpu|positive) and (.memoryMiB|positive) and (.diskGiB|positive) and (.maxAgents|positive) and
        (.role=="worker" or .role=="combined") and
        ((has("sourceProject")|not) or (.sourceProject=="") or ((.sourceProject|ident) and .sourceProject!=.project)) and
        ((has("enabled")|not) or (.enabled|type=="boolean"))
      )) and (.nodes|map(.id)|length==(unique|length)) and (.nodes|map(.remote)|length==(unique|length))
    ' "$file" >/dev/null || ductor_die 'Invalid Ductor configuration: check node IDs, broker fields and unique agents ordered with parents first.'
    while IFS= read -r url; do
        [[ $url =~ ^https://([A-Za-z0-9][A-Za-z0-9.-]*|\[[a-fA-F0-9:]+\])(:[0-9]{1,5})?$ ||
           $url =~ ^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]{1,5})?$ ]] ||
            ductor_die 'Service origins must use HTTPS, except HTTP on loopback. Paths, credentials and query strings are not accepted.'
    done < <(jq -r '.services | .paperclipUrl,.gatewayOrigin,.openbaoUrl,(.mempalaceUrl // empty)' "$file")
    jq -e '.services.publish // {} | to_entries | all((.key=="paperclip" or .key=="contextforge" or .key=="mempalace" or .key=="openbao") and (.value|type=="object") and (.value.bindAddress|type=="string") and (.value.port|type=="number" and floor==. and .>=1024 and .<=65535))' "$file" >/dev/null || ductor_die 'Service publication requires a literal bindAddress and a port from 1024 to 65535.'
    jq -e '[.services.publish // {} | .[].port] | length==(unique|length)' "$file" >/dev/null || ductor_die 'Each service needs a distinct published port.'
    while IFS= read -r address; do
        ductor_services_bind_address "$address" || ductor_die 'Service bindAddress must be a valid IPv4 or IPv6 literal.'
    done < <(jq -r '.services.publish // {} | .[].bindAddress' "$file")
}

ductor_config_seed() {
    if [[ -f $DUCTOR_STATE_DIR/config.json ]]; then
        ductor_config_validate "$DUCTOR_STATE_DIR/config.json" || return 1
        cat "$DUCTOR_STATE_DIR/config.json"
    else
        local role=combined
        if [[ -f $DUCTOR_STATE_DIR/setup.json ]]; then role=$(jq -er '.role' "$DUCTOR_STATE_DIR/setup.json") || return 1; fi
        jq -n --arg role "$role" --argjson brokerPort "${DUCTOR_BROKER_PORT:-22}" '{schemaVersion:1,role:$role,services:{paperclipUrl:"http://localhost:3100",gatewayOrigin:"http://localhost:4444",openbaoUrl:"http://localhost:8200"},credentials:{openbaoAdminTokenFile:""},identity:{emailDomain:""},access:{managedTls:false,email:"",trustProxy:false},broker:{host:"",user:"ductor-broker",port:$brokerPort,knownHostsFile:""},nodes:[],profiles:[],agents:[]}'
    fi
}

ductor_config_import() {
    local source=$1 destination="$DUCTOR_STATE_DIR/config.json" temporary backup
    ductor_config_validate "$source" || return 1
    [[ ! -L $destination ]] || ductor_die 'Refusing a symlinked configuration file.'
    if [[ -f $destination ]]; then
        ductor_config_validate "$destination" || return 1
        if [[ $(jq -Sc . "$destination") == "$(jq -Sc . "$source")" ]]; then ductor_log 'Configuration is unchanged.'; return 0; fi
    fi
    temporary=$(mktemp "$DUCTOR_STATE_DIR/.config.XXXXXXXX") || return 1
    if ! jq . "$source" >"$temporary"; then rm -f -- "$temporary"; return 1; fi
    chmod 600 -- "$temporary" || return 1
    if [[ -f $destination ]]; then
        backup=$(mktemp "$DUCTOR_STATE_DIR/config.previous.XXXXXXXX.json") || { rm -f -- "$temporary"; return 1; }
        if ! cp -- "$destination" "$backup"; then rm -f -- "$temporary" "$backup"; return 1; fi
        chmod 600 -- "$backup" || return 1
    fi
    mv -f -- "$temporary" "$destination" || return 1
    ductor_log "Configuration saved: $destination. Run ductor apply to reconcile it."
}

ductor_config_sync_nodes() (
    umask 077
    local work
    [[ -f $DUCTOR_STATE_DIR/inventory.json ]] || ductor_die 'No registered server inventory is available.'
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-config.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/old" || return 1
    jq --slurpfile inventory "$DUCTOR_STATE_DIR/inventory.json" '.nodes as $previous | .nodes=[$inventory[0].nodes[] as $node | $node | {id,remote,cpu,memoryMiB:.memory_mib,diskGiB:.disk_gib,maxAgents:.max_agents,project,profiles:(.profile|split(",")),pool,role,enabled} + ([$previous[] | select(.id==$node.id and has("sourceProject")) | {sourceProject}] | first // {})]' "$work/old" >"$work/new" || return 1
    ductor_config_import "$work/new"
)

ductor_config() {
    local action=${1:-show}; (($#==0)) || shift
    ductor_require_cmd jq
    case $action in
        show) (($#==0)) || ductor_die 'Usage: ductor config show'; ductor_config_seed ;;
        validate) (($#<=1)) || ductor_die 'Usage: ductor config validate [FILE]'; ductor_config_validate "${1:-$DUCTOR_STATE_DIR/config.json}"; ductor_log 'Configuration is valid; live services have not been probed.' ;;
        import) (($#==1)) || ductor_die 'Usage: ductor config import FILE'; ductor_config_import "$1" ;;
        sync-nodes) (($#==0)) || ductor_die 'Usage: ductor config sync-nodes'; ductor_config_sync_nodes ;;
        token-import) (($#==0)) || ductor_die 'Usage: ductor config token-import < private-token'; ductor_config_token_import ;;
        broker-host-key) ductor_config_broker_host_key "$@" ;;
        *) ductor_die 'Usage: ductor config show|validate [FILE]|import FILE|sync-nodes' ;;
    esac
}

# Use the local SSH daemon's existing public identity only when the operator has
# confirmed that its advertised broker host is this machine. Never ssh-keyscan.
ductor_config_broker_host_key() (
    umask 077
    local host=${1:-} port=${2:-${DUCTOR_BROKER_PORT:-22}} source directory="$DUCTOR_STATE_DIR/transport" key_type key_data temporary target
    source=$(ductor_broker_host_key_files | awk '/ssh_host_ed25519_key.pub$/ {print;exit}') || return 1
    (($#>=1 && $#<=2)) || ductor_die 'Usage: ductor config broker-host-key HOST [PORT]'
    [[ $host =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ && $port =~ ^[1-9][0-9]{0,4}$ ]] && ((port<=65535)) || ductor_die 'Invalid broker host or SSH port.'
    [[ -f $source && ! -L $source && $(stat -c %u -- "$source") == 0 ]] || ductor_die 'A root-owned local Ed25519 SSH host public key is required.'
    IFS=' ' read -r key_type key_data _ <"$source" || return 1
    [[ $key_type == ssh-ed25519 && $key_data =~ ^[A-Za-z0-9+/]+={0,3}$ ]] || ductor_die 'Malformed SSH host public key.'
    [[ ! -L $directory && ! -L $directory/broker-known_hosts ]] || ductor_die 'Refusing symlinked broker transport state.'
    mkdir -p -- "$directory"; chmod 700 -- "$directory"
    temporary=$(mktemp "$directory/.known-hosts.XXXXXXXX") || return 1
    trap 'rm -f -- "$temporary"' EXIT
    target=$host; [[ $port == 22 ]] || target="[$host]:$port"
    printf '%s %s %s\n' "$target" "$key_type" "$key_data" >"$temporary" || return 1
    chmod 600 -- "$temporary" || return 1
    mv -f -- "$temporary" "$directory/broker-known_hosts" || return 1
    printf '%s\n' "$directory/broker-known_hosts"
)

ductor_config_token_import() (
    set +x
    umask 077
    local token='' directory="$DUCTOR_STATE_DIR/credentials" temporary
    [[ ! -t 0 ]] || ductor_die 'Read the OpenBao administration token through stdin; never put it in command arguments.'
    IFS= read -r token || [[ -n $token ]] || ductor_die 'No OpenBao token received.'
    [[ ${#token} -ge 12 && ${#token} -le 16384 && $token =~ ^[A-Za-z0-9._~-]+$ ]] || ductor_die 'The OpenBao token is empty or malformed.'
    [[ ! -L $directory && ! -L $directory/openbao-admin.token ]] || ductor_die 'Refusing symlinked credential storage.'
    mkdir -p -- "$directory"; chmod 700 -- "$directory"
    temporary=$(mktemp "$directory/.token.XXXXXXXX") || return 1
    trap 'rm -f -- "$temporary"' EXIT
    printf '%s' "$token" >"$temporary" || return 1
    unset token
    chmod 600 -- "$temporary" || return 1
    mv -f -- "$temporary" "$directory/openbao-admin.token" || return 1
    printf '%s\n' "$directory/openbao-admin.token"
)

ductor_ui_budget() {
    local prompt=$1 default=$2 maximum=$3 answer
    while true; do
        answer=$(ductor_ui_input 'Server capacity' "$prompt (maximum $maximum)" "$default") || return 1
        if [[ $answer =~ ^[1-9][0-9]{0,8}$ ]] && ((answer<=maximum)); then printf '%s\n' "$answer"; return 0; fi
        ductor_ui_message 'Invalid capacity' 'Enter a positive whole number no greater than the measured hardware capacity.'
    done
}

ductor_wizard_node() (
    umask 077
    local role=${1:-worker} work id remote pool project profiles source_project='' probe cpu ram disk max_cpu max_ram max_disk maximum default_cpu default_ram default_count
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-node-wizard.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    id=$(ductor_ui_input 'Add server' 'Server identifier' worker1) || return 1
    remote=$(ductor_ui_input 'Add server' 'Existing Incus remote name' local) || return 1
    pool=$(ductor_ui_input 'Add server' 'Existing Incus storage pool' default) || return 1
    for probe in "$id" "$remote" "$pool"; do [[ $probe =~ ^[A-Za-z][A-Za-z0-9_-]{0,62}$ ]] || { ductor_ui_message 'Invalid identifier' 'Use letters, digits, hyphens or underscores; start with a letter.'; return 1; }; done
    if ! ductor_console_exec nodes probe "$remote" >"$work/probe"; then
        ductor_ui_message 'Server unavailable' 'The existing Incus remote could not be probed. Configure its authenticated connection, then add the server again.'
        return 1
    fi
    if ! ductor_incus_query "$remote" "/1.0/storage-pools/$pool/resources" >"$work/storage"; then
        ductor_ui_message 'Storage unavailable' 'The selected storage pool could not be inspected. No capacity was guessed or saved.'
        return 1
    fi
    max_cpu=$(jq -er '.cpu | select(type=="number" and .>0) | floor' "$work/probe") || return 1
    max_ram=$(jq -er '.memory_mib | select(type=="number" and .>0) | floor' "$work/probe") || return 1
    max_disk=$(jq -er '.space.total | select(type=="number" and .>0) | ./1073741824 | floor' "$work/storage") || return 1
    ((max_cpu>=1 && max_ram>=1 && max_disk>=1)) || { ductor_ui_message 'Insufficient capacity' 'The selected server and pool must expose at least one CPU thread, one MiB of memory and one GiB of storage.'; return 1; }
    default_cpu=$((max_cpu*3/4)); ((default_cpu>0)) || default_cpu=1
    default_ram=$((max_ram*3/4)); ((default_ram>0)) || default_ram=1
    ductor_ui_message 'Measured server capacity' "CPU threads: $max_cpu\nMemory: $max_ram MiB\nStorage pool: $max_disk GiB\n\nChoose the portion reserved for agents. Keep capacity for the OS, shared services and other workloads. These are reservation limits, not a promise of current free capacity."
    cpu=$(ductor_ui_budget 'CPU threads reserved for agents' "$default_cpu" "$max_cpu") || return 1
    ram=$(ductor_ui_budget 'Memory reserved for agents, MiB' "$default_ram" "$max_ram") || return 1
    disk=$(ductor_ui_budget 'Storage reserved for agents, GiB' "$((max_disk*3/4>0?max_disk*3/4:1))" "$max_disk") || return 1
    default_count=$((cpu/2)); ((default_count>0)) || default_count=1
    maximum=$(ductor_ui_budget 'Maximum concurrent/reserved agent VMs' "$default_count" 100000) || return 1
    project=$(ductor_ui_input 'Incus isolation' 'Restricted nondefault Incus project' ductor) || return 1
    if ductor_ui_confirm 'Prepare workload project' "Prepare a separate Ductor workload project '$project' from an approved existing platform project? Ductor copies its approved profiles and images and applies your quotas. It does not edit the source project. Decline to use an already prepared workload project unchanged."; then
        source_project=$(ductor_ui_input 'Approved platform' 'Existing approved platform source project' vdm-agents) || return 1
        [[ $source_project =~ ^[A-Za-z][A-Za-z0-9_-]{0,62}$ && $source_project != "$project" ]] || { ductor_ui_message 'Invalid source project' 'The approved source project must have a valid name and differ from the workload project.'; return 1; }
    fi
    profiles=$(ductor_ui_input 'Incus isolation' 'Existing Incus profiles, comma separated in application order' ductor) || return 1
    [[ $project != default && $project =~ ^[A-Za-z][A-Za-z0-9_-]{0,62}$ && $profiles =~ ^[A-Za-z][A-Za-z0-9_-]{0,62}(,[A-Za-z][A-Za-z0-9_-]{0,62})*$ ]] || { ductor_ui_message 'Invalid Incus configuration' 'Use a nondefault project and valid existing profile names.'; return 1; }
    jq -n --arg id "$id" --arg remote "$remote" --arg pool "$pool" --arg project "$project" --arg source "$source_project" --arg profiles "$profiles" --arg role "$role" --argjson cpu "$cpu" --argjson ram "$ram" --argjson disk "$disk" --argjson maximum "$maximum" '{id:$id,remote:$remote,cpu:$cpu,memoryMiB:$ram,diskGiB:$disk,maxAgents:$maximum,project:$project,sourceProject:$source,profiles:($profiles|split(",")),pool:$pool,role:$role,enabled:true}'
)

ductor_wizard() (
    umask 077
    local work role paperclip gateway bao token_file domain secret='' company applied=false retry=false login_url
    # This runs before jq, configuration parsing or dialog selection on a clean
    # host. The child dependency command owns package-manager confirmation.
    ductor_console_dependencies tools || return 1
    ductor_require_cmd jq
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-wizard.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    role=$(ductor_ui_menu 'Ductor setup' 'Choose the role of this installation. Servers can be added later.' control 'Shared services and fleet controller' worker 'Incus execution server; services elsewhere' combined 'Shared services and Incus on this server') || return 0
    case $role in control|worker|combined) ;; *) ductor_ui_message 'Invalid role' 'Choose control, worker or combined.'; return 1 ;; esac
    if [[ $role == worker ]]; then ductor_ui_message 'Shared service locations' 'For a separate worker server, enter the HTTPS origins of your existing controller services. Loopback addresses are appropriate only when those services are reachable through local authenticated forwarding.'; fi
    paperclip=$(ductor_ui_input 'Service connections' 'Paperclip origin; HTTPS for remote access' "$(jq -r .services.paperclipUrl "$work/config")") || return 0
    gateway=$(ductor_ui_input 'Service connections' 'ContextForge origin; HTTPS for remote access' "$(jq -r .services.gatewayOrigin "$work/config")") || return 0
    bao=$(ductor_ui_input 'Service connections' 'OpenBao origin; HTTPS for remote access' "$(jq -r .services.openbaoUrl "$work/config")") || return 0
    domain=$(ductor_ui_input 'Service identities' 'Your real email domain for scoped service users' "$(jq -r '.identity.emailDomain // ""' "$work/config")") || return 0
    [[ $domain =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ && $domain != example.com && $domain != example.org && $domain != example.net ]] || { ductor_ui_message 'Email domain required' 'Enter a real domain you control for service identities.'; return 1; }
    token_file=$(ductor_ui_input 'OpenBao administration' 'Existing private OpenBao admin token file; leave blank to configure later' "$(jq -r '.credentials.openbaoAdminTokenFile // ""' "$work/config")") || return 0
    if [[ -z $token_file ]] && ductor_ui_confirm 'OpenBao administration' 'Enter an existing OpenBao administration token now? It will be stored in a private local file, never inside config.json.'; then
        secret=$(ductor_ui_secret 'OpenBao administration' 'OpenBao administration token (hidden)') || return 0
        token_file=$(printf '%s\n' "$secret" | ductor_console_exec config token-import) || { unset secret; return 1; }
        unset secret
    fi
    if [[ -n $token_file ]]; then
        [[ $token_file == /* && -f $token_file && ! -L $token_file && $(stat -c %a -- "$token_file") == 600 && $(stat -c %u -- "$token_file") == "$(id -u)" ]] || { ductor_ui_message 'Private token file required' 'The token file must be an absolute regular file owned by this operator with mode 600.'; return 1; }
    fi
    jq --arg role "$role" --arg paperclip "${paperclip%/}" --arg gateway "${gateway%/}" --arg bao "${bao%/}" --arg token "$token_file" --arg domain "$domain" '.role=$role | .services.paperclipUrl=$paperclip | .services.gatewayOrigin=$gateway | .services.openbaoUrl=$bao | .credentials.openbaoAdminTokenFile=$token | .identity.emailDomain=$domain' "$work/config" >"$work/next" || return 1
    mv "$work/next" "$work/config"
    if [[ $role != worker ]] && ductor_ui_confirm 'Service networking' 'Configure each Docker service listen address and port for your own reverse proxy? TLS certificates and domains remain under your control. Existing settings are retained if you defer this.'; then
        ductor_console_network_form "$work/config" || return 1
    fi
    if ductor_ui_confirm 'Broker transport' 'Configure the authenticated SSH broker used by Paperclip to request isolated environments? You can leave this pending until the controller has an advertised address.'; then
        if ductor_wizard_broker "$work/config" >"$work/broker"; then
            jq --slurpfile broker "$work/broker" '.broker=$broker[0]' "$work/config" >"$work/next" || return 1
            mv "$work/next" "$work/config"
        else
            ductor_ui_message 'Broker setup incomplete' 'Existing broker settings were retained. Environment provisioning stays pending until the SSH broker is verified.'
        fi
    fi
    if [[ $role != control ]] && ductor_ui_confirm 'Worker capacity' 'Configure the measured resource budget for an Incus execution server now?'; then
        if ductor_wizard_node "$role" >"$work/node"; then
            jq --slurpfile node "$work/node" '.nodes=(.nodes | map(select(.id!=$node[0].id)))+[$node[0]]' "$work/config" >"$work/next" || return 1
            mv "$work/next" "$work/config"
        else
            ductor_ui_message 'Worker setup incomplete' 'No worker budget was changed. You can save the other settings and add the server later.'
        fi
    fi
    ductor_config_validate "$work/config" || return 1
    if ! ductor_ui_confirm 'Save configuration' "Save the desired configuration for role '$role'?\n\n$(jq -r '.services | to_entries[] | select(.value|type=="string") | .key+": "+.value' "$work/config")\n\nServers: $(jq '.nodes|length' "$work/config")\nExisting agent profiles are retained. Saving does not mark any service ready."; then return 0; fi
    ductor_console_exec config import "$work/config" || return 1
    if ductor_ui_confirm 'Create an agent type' 'Configure a reusable agent type now? The form needs your Paperclip company, connected ChatGPT subscription/grant IDs and exact model. If initial account onboarding is still pending, choose Agent types from the menu afterward.'; then
        ductor_console_profile_create || ductor_ui_message 'Agent type pending' 'The saved infrastructure configuration was retained. Complete the agent type from the menu when its required account and image details are available.'
    fi
    if ductor_ui_confirm 'Declare an agent' 'Add a desired agent from an approved profile now? Declare managers before their children. Apply registers it with Paperclip; its isolated VM starts on the first run.'; then
        ductor_console_agent_create defer || ductor_ui_message 'Agent declaration pending' 'The saved configuration was retained. Add the agent from the menu after configuring its profile.'
    fi
    if ductor_ui_confirm 'Apply configuration' 'Reconcile this configuration now? Ductor will run the actual installation and connection checks. Failed steps remain visible and can be resumed.'; then
        ductor_console_dependencies "$role" || return 1
        if ductor_console_run 'Apply Ductor configuration' apply; then applied=true; else
            ductor_ui_message 'Deployment pending' 'The configuration was saved, but deployment is incomplete. Initial service startup can finish before account approval, OpenBao initialization or broker configuration. Complete the pending connections below, then retry.'
        fi
        if [[ $role != worker ]] && ductor_ui_confirm 'OpenBao initialization' 'Initialize a new OpenBao instance now? Choose this only for a fresh, uninitialized instance. The guided command writes recovery material to a new private file.'; then
            if ductor_console_bao_init; then retry=true; fi
        fi
        if [[ $role != worker ]] && ductor_ui_confirm 'OpenBao unsealing' 'Enter existing OpenBao unseal shares now? Each share is entered privately in the terminal and is never stored by the console.'; then
            if ductor_console_bao_unseal; then retry=true; fi
        fi
        if ductor_ui_confirm 'Paperclip sign-in' 'Connect this controller to your Paperclip company using its native browser approval flow now? Provider subscriptions are configured in Paperclip.'; then
            login_url=$(ductor_console_paperclip_url) || return 1
            if [[ $login_url == http://localhost:* || $login_url == http://127.0.0.1:* ]]; then
                ductor_ui_message 'Private first-run sign-in' "Paperclip currently uses $login_url for onboarding. Forward that port to your computer before opening the approval links and completing the owner claim. Your reverse proxy and desired public origins are checked during apply."
            fi
            company=$(ductor_ui_input 'Paperclip company' 'Company UUID shown in Paperclip') || return 0
            if ductor_console_exec paperclip login --url "$login_url" --company "$company"; then retry=true; else
                ductor_ui_message 'Paperclip sign-in pending' 'Native approval did not finish. Open the Paperclip URL to complete owner onboarding, then use Connections → Connect Paperclip and retry apply.'
            fi
        else
            ductor_ui_message 'Authentication pending' 'Paperclip operator sign-in is still pending unless already configured. Use Connections → Connect Paperclip when ready. No agent readiness has been assumed.'
        fi
        if ductor_ui_confirm 'Configure credentials' 'Configure or update the OpenBao administration token now? Initialize and unseal OpenBao through its own interface first.'; then
            if ductor_console_credentials; then retry=true; fi
        fi
        if [[ $applied == false || $retry == true ]] && ductor_ui_confirm 'Retry apply' 'Retry the saved deployment now? Readiness is reported only by the live reconciliation checks.'; then
            ductor_console_run 'Retry Ductor configuration' apply || return 1
        elif [[ $applied == false ]]; then
            ductor_ui_message 'Deployment still pending' 'Your configuration is saved. Use Connections and Apply configuration from the menu to finish deployment.'
        fi
    else
        ductor_ui_message 'Configuration saved' 'Run ductor apply when ready, or choose Apply configuration from the menu.'
    fi
)

ductor_console_paperclip_url() {
    local url settings="$DUCTOR_STATE_DIR/services/settings.env" role
    role=$(ductor_config_seed | jq -r .role) || return 1
    if [[ $role != worker && -f $settings && ! -L $settings ]]; then
        url=$(awk 'index($0,"PAPERCLIP_PUBLIC_URL=")==1 {sub(/^PAPERCLIP_PUBLIC_URL=/,""); print; exit}' "$settings") || return 1
    else
        url=$(ductor_config_seed | jq -r .services.paperclipUrl) || return 1
    fi
    [[ $url =~ ^https://([A-Za-z0-9][A-Za-z0-9.-]*|\[[a-fA-F0-9:]+\])(:[0-9]{1,5})?$ || $url =~ ^http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]{1,5})?$ ]] || ductor_die 'Rendered Paperclip URL is invalid or missing; inspect services/settings.env.'
    printf '%s\n' "$url"
}

ductor_wizard_broker() (
    local config=$1 host user port known
    host=$(ductor_ui_input 'Broker transport' 'Broker host reachable from the Paperclip service; blank leaves provisioning pending' "$(jq -r '.broker.host // ""' "$config")") || return 1
    user=$(ductor_ui_input 'Broker transport' 'Dedicated SSH broker username' "$(jq -r '.broker.user // "ductor-broker"' "$config")") || return 1
    port=$(ductor_ui_budget 'Broker SSH port' "$(jq -r --argjson port "${DUCTOR_BROKER_PORT:-22}" '.broker.port // $port' "$config")" 65535) || return 1
    known=$(ductor_ui_input 'Broker transport' 'Absolute path to independently verified SSH known_hosts file; blank configures later' "$(jq -r '.broker.knownHostsFile // ""' "$config")") || return 1
    if [[ -n $host && -z $known && $(jq -r .role "$config") != worker ]] &&
        ductor_ui_confirm 'Use this server identity' "Does '$host' point to this controller's SSH broker? Use this controller's persistent Ed25519 SSH host public key as the trusted identity. Only confirm for this controller; remote identities must be independently verified."; then
        known=$(ductor_console_exec config broker-host-key "$host" "$port") || return 1
    fi
    if [[ -n $known ]]; then
        [[ $known == /* && -f $known && ! -L $known && -s $known ]] || { ductor_ui_message 'Known host file required' 'Select a nonempty regular file containing the independently verified broker SSH host key.'; return 1; }
    fi
    jq -n --arg host "$host" --arg user "$user" --argjson port "$port" --arg known "$known" '{host:$host,user:$user,port:$port,knownHostsFile:$known}'
)

ductor_console_credentials() (
    set +x
    umask 077
    local work token_file secret=''
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-credentials.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    ductor_config_seed >"$work/config" || return 1
    token_file=$(ductor_ui_input 'OpenBao administration' 'Existing private OpenBao admin token file; blank to enter a token' "$(jq -r '.credentials.openbaoAdminTokenFile // ""' "$work/config")") || return 1
    if [[ -z $token_file ]]; then
        secret=$(ductor_ui_secret 'OpenBao administration' 'OpenBao administration token (hidden)') || return 1
        token_file=$(printf '%s\n' "$secret" | ductor_console_exec config token-import) || { unset secret; return 1; }
        unset secret
    fi
    [[ $token_file == /* && -f $token_file && ! -L $token_file && $(stat -c %a -- "$token_file") == 600 && $(stat -c %u -- "$token_file") == "$(id -u)" ]] || { ductor_ui_message 'Private token file required' 'The token file must be an absolute regular file owned by this operator with mode 600.'; return 1; }
    jq --arg token "$token_file" '.credentials.openbaoAdminTokenFile=$token' "$work/config" >"$work/new" || return 1
    ductor_console_exec config import "$work/new"
)

ductor_console_bao_init() {
    local recovery
    recovery=$(ductor_ui_input 'Initialize OpenBao' 'New absolute path for private recovery JSON; the file must not exist' "$DUCTOR_STATE_DIR/openbao-recovery.json") || return 1
    [[ $recovery == /* && ! -e $recovery && ! -L $recovery ]] || { ductor_ui_message 'New recovery file required' 'Choose a new absolute file path. Existing recovery material must never be overwritten.'; return 1; }
    if ductor_ui_confirm 'Create recovery material' "Initialize OpenBao and save five recovery shares plus the initial root token privately at '$recovery'? Three distinct shares are required to unseal. The console will not display or import these secrets. Preserve the file and distribute recovery shares securely."; then
        ductor_console_run 'Initialize OpenBao' services bao-init "$recovery"
    else
        return 1
    fi
}

ductor_console_bao_unseal() {
    while true; do
        # Keep the native hidden terminal prompt interactive; never route this
        # command through a captured dialog or read a recovery file ourselves.
        ductor_console_exec services bao-unseal || return 1
        ductor_ui_confirm 'Another unseal share' 'Is OpenBao still sealed, and do you want to enter another distinct share?' || return 0
    done
}

ductor_console_secret_import() {
    local name input admin mode
    local -a arguments=()
    admin=$(ductor_config_seed | jq -r '.credentials.openbaoAdminTokenFile // ""') || return 1
    if [[ -z $admin ]]; then
        ductor_ui_message 'Administration credential required' 'Configure the private administration token file before importing service credentials.'
        ductor_console_credentials || return 1
        admin=$(ductor_config_seed | jq -r '.credentials.openbaoAdminTokenFile // ""') || return 1
    fi
    name=$(ductor_ui_input 'Service credential' 'Scoped credential name, for example github/project-a') || return 0
    input=$(ductor_ui_input 'Service credential' 'Absolute path to private credential JSON; operator-owned mode 600') || return 0
    mode=$(ductor_ui_menu 'Service credential operation' 'Import through OpenBao. Tools still require a separate scoped connector grant.' create 'Create a new credential; fail if it already exists' replace 'Intentionally create a new version of an existing credential') || return 0
    arguments=(services secret-import "$name" "$input" "$admin")
    case $mode in create) ;; replace) arguments+=(--replace) ;; *) return 1 ;; esac
    if ductor_ui_confirm 'Import service credential' "Import '$name' from the private JSON file using the configured OpenBao administration token? Operation: $mode. Credential values stay out of configuration, command arguments and logs."; then
        ductor_console_run 'Store scoped service credential' "${arguments[@]}"
    fi
}

ductor_console_servers() (
    umask 077
    local action id work
    work=$(mktemp -d "${TMPDIR:-/tmp}/ductor-servers.XXXXXXXX") || return 1
    trap 'rm -rf -- "$work"' EXIT
    action=$(ductor_ui_menu 'Servers' 'Configure existing authenticated Incus remotes and their budgets.' list 'List registered servers' add 'Add server using detected hardware' drain 'Drain server: stop admitting new agents' enable 'Enable a drained server' remove 'Remove an empty server from management') || return 0
    case $action in
        list) ductor_console_run 'Server inventory' nodes list ;;
        add)
            ductor_wizard_node worker >"$work/node" || return 1
            ductor_config_seed >"$work/config" || return 1
            jq --slurpfile node "$work/node" '.nodes=(.nodes | map(select(.id!=$node[0].id)))+[$node[0]]' "$work/config" >"$work/new" || return 1
            ductor_console_exec config import "$work/new" || return 1
            if ductor_ui_confirm 'Apply server configuration' 'Apply this server declaration now? Approved platform preparation and quota checks run before it is admitted to the fleet.'; then ductor_console_run 'Register and verify server' apply; fi
            ;;
        drain|enable|remove)
            id=$(ductor_ui_input 'Server operation' 'Registered server identifier') || return 0
