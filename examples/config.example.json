{
  "schema_version": 2,
  "name": "example",
  "hosts": {
    "control": {
      "address": "127.0.0.1",
      "port": 2222,
      "user": "deploy",
      "identity_file": "/var/lib/ductor/inputs/ssh-key",
      "known_hosts_file": "/var/lib/ductor/inputs/known-hosts",
      "become": true,
      "data_root": "/srv/ductor",
      "roles": [
        "services",
        "incus"
      ],
      "resources": {
        "cpus": 16,
        "memory_mib": 32768,
        "disk_gib": 250,
        "reserve_cpus": 2,
        "reserve_memory_mib": 4096,
        "reserve_disk_gib": 30
      }
    }
  },
  "services": {
    "bao": {
      "kind": "openbao",
      "host": "control",
      "enabled": true,
      "image": "ghcr.io/openbao/openbao:2.7.1",
      "bind_address": "127.0.0.1",
      "port": 8200,
      "url": "https://bao.example.org",
      "cpus": 1,
      "memory_mib": 1024,
      "disk_gib": 20
    },
    "agents": {
      "kind": "openclaw",
      "host": "control",
      "enabled": true,
      "image": "ghcr.io/openclaw/openclaw:2026.10.5",
      "bind_address": "127.0.0.1",
      "port": 18789,
      "url": "https://agents.example.org",
      "cpus": 2,
      "memory_mib": 4096,
      "disk_gib": 40,
      "required_pool": "workers",
      "agents": [
        "lead",
        "worker",
        "reviewer"
      ],
      "trusted_proxies": [],
      "allowed_origins": [
        "https://agents.example.org"
      ],
      "openbao_service": "bao",
      "provider_keys": {
        "openai": "gateways/agents/openai/apiKey"
      }
    }
  },
  "incus": {
    "pools": {
      "workers": {
        "host": "control",
        "address": "https://incus.example.org:8443",
        "project": "ductor-workers",
        "profile": "ductor-worker",
        "instance_type": "virtual-machine",
        "image_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "image_source_project": "default",
        "worker_node_version": "24.16.0",
        "allow_vm_lowlevel": true,
        "network": "incusbr0",
        "network_acl": "ductor-workers",
        "storage_pool": "default",
        "client_certificate_file": "/var/lib/ductor/inputs/incus.crt",
        "client_key_file": "/var/lib/ductor/inputs/incus.key",
        "server_certificate_file": "/var/lib/ductor/inputs/server.crt",
        "cpus": 8,
        "memory_mib": 16384,
        "disk_gib": 120,
        "instance_cpus": 2,
        "instance_memory_mib": 4096,
        "instance_disk_gib": 30,
        "max_instances": 4
      }
    }
  },
  "agents": [
    {
      "id": "lead",
      "name": "Lead",
      "model": "openai/gpt-6-astra",
      "runtime": "openclaw",
      "role": "orchestrator",
      "auth_profiles": [],
      "allow_agents": [
        "worker",
        "reviewer"
      ]
    },
    {
      "id": "worker",
      "name": "Worker",
      "model": "openai/gpt-6-astra",
      "runtime": "openclaw",
      "role": "worker",
      "auth_profiles": [],
      "allow_agents": []
    },
    {
      "id": "reviewer",
      "name": "Reviewer",
      "model": "openai/gpt-6-astra",
      "runtime": "openclaw",
      "role": "reviewer",
      "auth_profiles": [],
      "allow_agents": []
    }
  ],
  "model_accounts": {},
  "runtime": {
    "max_concurrent": 4,
    "max_children": 2,
    "max_depth": 2,
    "run_timeout_seconds": 1800
  },
  "knowledge": {
    "source_dir": "/var/lib/ductor/inputs/knowledge"
  },
  "credentials": {
    "gateway_token_files": {
      "agents": "/var/lib/ductor/inputs/gateway-token"
    },
    "openbao_token_file": "/var/lib/ductor/inputs/operator-token",
    "openbao_unseal_file": "/var/lib/ductor/inputs/recovery.json",
    "openbao_bootstrap_output_file": "/var/lib/ductor/inputs/recovery.json",
    "openbao_approles": {
      "agents": {
        "role_id_file": "/var/lib/ductor/inputs/role-id",
        "secret_id_file": "/var/lib/ductor/inputs/secret-id"
      }
    }
  }
}
